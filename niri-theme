#!/usr/bin/env bash
# niri-theme - recolor niri, waybar and mako from the same theme files as dwm.
#
#   niri-theme pick            choose a theme (fuzzel menu, Super+Shift+T)
#   niri-theme set <name>      apply a theme by file name (e.g. nord, everforest-dark)
#   niri-theme list            list the installed themes
#   niri-theme init            apply the saved theme (or dwm's current theme)
#   niri-theme from-image <file> [--light]   build a theme from a picture's colors and apply it
#
# Besides niri, waybar and mako it also recolors kitty (and open kitty windows).
# Theme files live in ~/.config/dwm-theme/themes (installed by le-dwm-config's
# installer) and are shared with dwm, so both setups can use the same palette.
set -u

CONF="${XDG_CONFIG_HOME:-$HOME/.config}"
THEME_DIR="$CONF/dwm-theme/themes"
NIRI_DIR="$CONF/niri"
WAYBAR_DIR="$CONF/waybar"
MAKO_DIR="$CONF/mako"
CURRENT="$NIRI_DIR/theme"
BIN="$HOME/.local/bin"

die() { echo "niri-theme: $*" >&2; exit 1; }
say() { printf '%s\n' "$*"; }

list_themes() {
	local f
	for f in "$THEME_DIR"/*.theme; do
		[[ -r $f ]] || continue
		basename "$f" .theme
	done
}

default_theme() {
	local t=""
	[[ -r $CURRENT ]] && t=$(<"$CURRENT")
	[[ -n $t && -r $THEME_DIR/$t.theme ]] || t=$(cat "$CONF/dwm-theme/current" 2>/dev/null || true)
	[[ -n $t && -r $THEME_DIR/$t.theme ]] || t=nord
	printf '%s\n' "$t"
}

write_colors() {
	local name=$1
	# shellcheck source=/dev/null
	. "$THEME_DIR/$name.theme"

	[[ -n ${BG:-} && -n ${FG:-} && -n ${ACCENT:-} ]] || die "$name.theme is missing BG, FG or ACCENT"

	mkdir -p "$NIRI_DIR" "$WAYBAR_DIR" "$MAKO_DIR" || die "cannot create config directories"

	# --- niri layout colors (version 25.11+ supports top-level includes) ---
	cat > "$NIRI_DIR/colors.kdl" <<EOF
// generated by niri-theme from $name.theme - do not edit by hand
layout {
    focus-ring {
        active-color "$ACCENT"
        inactive-color "$BG_HI"
        urgent-color "$RED"
    }

    border {
        active-color "$ACCENT"
        inactive-color "$BG_HI"
        urgent-color "$RED"
    }

    tab-indicator {
        active-color "$ACCENT"
        inactive-color "$BG_HI"
        urgent-color "$RED"
    }

    insert-hint {
        color "${ACCENT}80"
    }

    shadow {
        color "#00000055"
    }

    background-color "$BG"
}

overview {
    backdrop-color "$BG"
}
EOF

	# --- waybar colors (imported by style-top.css and style-bottom.css) ---
	cat > "$WAYBAR_DIR/colors.css" <<EOF
/* generated by niri-theme from $name.theme - do not edit by hand */
@define-color bg $BG;
@define-color bg_alt $BG_ALT;
@define-color bg_hi $BG_HI;
@define-color fg $FG;
@define-color fg_dim $FG_DIM;
@define-color accent $ACCENT;
@define-color accent_fg $ACCENT_FG;
@define-color red $RED;
@define-color green $GREEN;
@define-color yellow $YELLOW;
@define-color blue $BLUE;
@define-color magenta $MAGENTA;
@define-color cyan $CYAN;
EOF

	# --- mako notifications ---
	cat > "$MAKO_DIR/config" <<EOF
# generated by niri-theme from $name.theme
font=JetBrainsMono Nerd Font 11
background-color=${BG}ee
text-color=$FG
border-color=$ACCENT
progress-color=over ${BG_ALT}cc
border-size=1
border-radius=8
default-timeout=5000
icons=1
max-icon-size=48
margin=8
padding=10
anchor=top-right
EOF

	# --- kitty (the same file dwm-theme writes, so both sessions share it) ---
	mkdir -p "$CONF/kitty"
	cat > "$CONF/kitty/dwm-theme.conf" <<EOF
# generated by niri-theme: $name
foreground $FG
background $BG
selection_foreground $ACCENT_FG
selection_background $ACCENT
cursor $ACCENT
cursor_text_color $BG
url_color $BLUE
active_border_color $ACCENT
inactive_border_color $BG_HI
color0 $BG_HI
color1 $RED
color2 $GREEN
color3 $YELLOW
color4 $BLUE
color5 $MAGENTA
color6 $CYAN
color7 $FG
color8 $FG_DIM
color9 $RED
color10 $GREEN
color11 $YELLOW
color12 $BLUE
color13 $MAGENTA
color14 $CYAN
color15 $FG
EOF

	printf '%s\n' "$name" > "$CURRENT"

	# waybar reloads its CSS on SIGUSR2 (both bars); kitty reloads its config on SIGUSR1.
	# NixOS wraps programs, so the process is called .waybar-wrapped / .kitty-wrapped there.
	{ pkill -USR2 -x waybar; pkill -USR2 -x .waybar-wrapped; } 2>/dev/null || true
	{ pkill -USR1 -x kitty; pkill -USR1 -x .kitty-wrapped; } 2>/dev/null || true
	command -v makoctl >/dev/null 2>&1 && makoctl reload 2>/dev/null || true

	# niri redraws with the new color file automatically, but a reload here
	# helps when the script is run from outside the session.
	command -v niri >/dev/null 2>&1 && niri msg action do-screen-transition >/dev/null 2>&1 || true
}

pick_theme() {
	local themes sel
	themes=$(list_themes)
	[[ -n $themes ]] || die "no themes in $THEME_DIR (run the installer first)"
	if command -v fuzzel >/dev/null 2>&1; then
		sel=$(printf '%s\n' "$themes" | fuzzel --dmenu --prompt "Theme  ")
	elif command -v rofi >/dev/null 2>&1; then
		sel=$(printf '%s\n' "$themes" | rofi -dmenu -p "Theme")
	elif command -v dmenu >/dev/null 2>&1; then
		sel=$(printf '%s\n' "$themes" | dmenu -i -p "Theme")
	else
		die "install fuzzel, rofi or dmenu to pick a theme"
	fi
	[[ -n ${sel:-} ]] || exit 0
	set_theme "$sel"
}

set_theme() {
	local name=${1:-}
	[[ -n $name ]] || die "usage: niri-theme set <name>"
	name=${name%.theme}
	[[ -r $THEME_DIR/$name.theme ]] || die "no such theme: $name (try: niri-theme list)"
	write_colors "$name"
	say "niri theme: $name"
}

# Build a palette from a wallpaper with dwm-palette (needs python pillow), then apply it.
from_image() {
	local light=() files=() a pal tmp
	for a in "$@"; do
		case $a in
			--light) light+=(--light) ;;
			*) files+=("$a") ;;
		esac
	done
	((${#files[@]})) || die "usage: niri-theme from-image [--light] <image>"
	[[ -f ${files[0]} ]] || die "not a file: ${files[0]}"
	if [[ -x $BIN/dwm-palette ]]; then pal=$BIN/dwm-palette
	else pal=$(command -v dwm-palette) || die "dwm-palette is missing (run the installer)"; fi
	tmp=$(mktemp) || die "cannot create a temporary file"
	if ! "$pal" "${light[@]}" "${files[@]}" > "$tmp" 2>"$tmp.err"; then
		local why; why=$(tail -n1 "$tmp.err")
		rm -f "$tmp" "$tmp.err"
		die "palette failed: ${why:-unknown error}"
	fi
	mkdir -p "$THEME_DIR"
	mv "$tmp" "$THEME_DIR/wallpaper.theme"
	rm -f "$tmp.err"
	set_theme wallpaper
}

case "${1:-init}" in
	from-image) shift; from_image "$@" ;;
	pick) pick_theme ;;
	set)  shift; set_theme "${1:-}" ;;
	list) list_themes ;;
	init) set_theme "$(default_theme)" ;;
	*)    die "usage: niri-theme [pick|list|init|set <name>|from-image <file>]" ;;
esac
