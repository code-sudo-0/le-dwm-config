#!/usr/bin/env bash
# dwm-display - display settings for dwm: resolution, refresh rate, rotation,
# arrangement and primary monitor. Saves the layout so start-dwm applies it at
# login.
#
# Usage:
#   dwm-display                 open the menu
#   dwm-display status          print the connected displays and their modes
#   dwm-display apply           apply the saved layout (used by start-dwm)
#   dwm-display save            save the current layout for login
#   dwm-display reset           xrandr --auto (automatic layout)
#
# The saved layout lives in ~/.config/dwm-theme/display.sh.
set -u

CONF="${HOME}/.config/dwm-theme"
STATE="${CONF}/display.sh"
BIN="${HOME}/.local/bin"
MENU="${BIN}/dwm-menu"

msg() {
	echo "dwm-display: $*" >&2
	command -v notify-send >/dev/null 2>&1 && notify-send -a dwm-display "$*" 2>/dev/null
	return 0
}

have_xrandr() {
	command -v xrandr >/dev/null 2>&1 && [[ -n ${DISPLAY:-} ]]
}

# One line per connected output: name|primary|geometry|mode|rate|rotation
# A connected but disabled output has an empty geometry and mode.
parse_outputs() {
	xrandr --query 2>/dev/null | awk '
	/^[^ \t]+ (connected|disconnected)/ {
		if (out != "" && conn == "connected")
			print out "|" prim "|" geom "|" mode "|" rate "|" rot;
		out = $1; conn = $2; prim = 0; geom = ""; mode = ""; rate = ""; rot = "normal";
		for (i = 3; i <= NF; i++) {
			if ($i == "primary")
				prim = 1;
			else if ($i ~ /^[0-9]+x[0-9]+\+[0-9-]+\+[0-9-]+$/)
				geom = $i;
			else if ($i ~ /^\(/) {
				rot = $i;
				sub(/^\(/, "", rot);
			}
		}
		next;
	}
	/^[ \t]+[0-9]+x[0-9]+/ {
		if (out == "" || conn != "connected" || mode != "")
			next;
		m = $1;
		for (i = 2; i <= NF; i++) {
			if ($i ~ /\*/) {
				r = $i;
				gsub(/\*/, "", r);
				mode = m;
				rate = r;
				break;
			}
		}
	}
	END {
		if (out != "" && conn == "connected")
			print out "|" prim "|" geom "|" mode "|" rate "|" rot;
	}
	'
}

outputs() {
	parse_outputs | cut -d'|' -f1
}

output_label() {
	local out=$1 prim=$2 mode=$3 rate=$4
	local label="$out"
	[[ $prim == 1 ]] && label="$label (primary)"
	if [[ -n $mode ]]; then
		label="$label: $mode @ ${rate} Hz"
	else
		label="$label: off"
	fi
	printf '%s' "$label"
}

summary() {
	local out prim geom mode rate rot any=0
	while IFS='|' read -r out prim geom mode rate rot; do
		any=1
		printf '%s\n' "$(output_label "$out" "$prim" "$mode" "$rate")"
	done < <(parse_outputs)
	((any)) || printf 'no connected displays\n'
}

# All modes/rates for one output as: mode|rate|marker (marker is current/preferred/empty)
modes_for() {
	xrandr --query 2>/dev/null | awk -v out="$1" '
	$1 == out { inside = 1; next }
	inside && /^[^ \t]/ { exit }
	inside && /^[ \t]+[0-9]+x[0-9]+/ {
		m = $1;
		for (i = 2; i <= NF; i++) {
			r = $i;
			current = (r ~ /\*/);
			preferred = (r ~ /\+/);
			gsub(/\*/, "", r);
			gsub(/\+/, "", r);
			if (r ~ /^[0-9]+(\.[0-9]+)?$/)
				print m "|" r "|" (current ? "current" : (preferred ? "preferred" : ""));
		}
	}
	'
}

pick_output() {
	local prompt=$1 list choice
	list=$(parse_outputs | while IFS='|' read -r out prim geom mode rate rot; do
		printf '%s|%s\n' "$(output_label "$out" "$prim" "$mode" "$rate")" "$out"
	done)
	[[ -n $list ]] || { msg "no connected displays"; return 1; }
	choice=$(printf '%s\n' "$list" | "$MENU" "$prompt") || return 1
	[[ -n $choice ]] || return 1
	printf '%s\n' "$choice" | awk -F'|' '{ print $NF }'
}

save_layout() {
	mkdir -p "$CONF"
	{
		printf '#!/bin/sh\n'
		printf '# generated by dwm-display on %s - applied at login by start-dwm\n' "$(date '+%F %T')"
		local any=0 out prim geom mode rate rot pos
		while IFS='|' read -r out prim geom mode rate rot; do
			any=1
			if [[ -z $mode ]]; then
				printf 'xrandr --output %q --off\n' "$out"
				continue
			fi
			pos=""
			if [[ $geom =~ \+([0-9-]+)\+([0-9-]+)$ ]]; then
				pos="${BASH_REMATCH[1]}x${BASH_REMATCH[2]}"
			fi
			printf 'xrandr --output %q --mode %q' "$out" "$mode"
			[[ -n $rate ]] && printf ' --rate %q' "$rate"
			[[ -n $rot ]] && printf ' --rotate %q' "$rot"
			[[ $prim == 1 ]] && printf ' --primary'
			[[ -n $pos ]] && printf ' --pos %q' "$pos"
			printf '\n'
		done < <(parse_outputs)
		((any)) || printf 'xrandr --auto\n'
	} > "$STATE"
	echo "saved $STATE"
}

apply_layout() {
	have_xrandr || return 0
	if [[ -s $STATE ]]; then
		sh "$STATE" || { msg "could not apply $STATE (is the monitor still connected?)"; return 1; }
	else
		xrandr --auto || return 1
	fi
}

set_mode() {
	local out=$1 mode=$2 rate=$3
	if [[ $mode == auto ]]; then
		xrandr --output "$out" --auto || { msg "could not enable $out"; return 1; }
	elif [[ $mode == off ]]; then
		xrandr --output "$out" --off || { msg "could not turn off $out"; return 1; }
	elif [[ -n $rate ]]; then
		xrandr --output "$out" --mode "$mode" --rate "$rate" || { msg "could not set $out to $mode @ $rate Hz"; return 1; }
	else
		xrandr --output "$out" --mode "$mode" || { msg "could not set $out to $mode"; return 1; }
	fi
	save_layout >/dev/null
}

change_mode() {
	local out choice mode rate entries
	out=$(pick_output "display") || return 0
	entries=$(modes_for "$out" | awk -F'|' '
		{
			label = $1 " @ " $2 " Hz";
			if ($3 == "current") label = label "  (current)";
			else if ($3 == "preferred") label = label "  (preferred)";
			print label "|" $1 "|" $2;
		}')
	entries=$(printf '%s\n' "Automatic (preferred mode)|auto|" "Turn this display off|off|" "$entries")
	choice=$(printf '%s\n' "$entries" | "$MENU" "resolution: $out") || return 0
	[[ -n $choice ]] || return 0
	IFS='|' read -r _ mode rate <<< "$choice"
	set_mode "$out" "$mode" "$rate"
}

set_primary() {
	local out
	out=$(pick_output "primary display") || return 0
	xrandr --output "$out" --primary || { msg "could not make $out primary"; return 1; }
	save_layout >/dev/null
}

rotate_output() {
	local out choice rot
	out=$(pick_output "rotate display") || return 0
	choice=$(printf '%s\n' \
		"Normal (landscape)|normal" \
		"Rotate left (portrait)|left" \
		"Rotate right (portrait)|right" \
		"Upside down|inverted" | "$MENU" "rotation: $out") || return 0
	[[ -n $choice ]] || return 0
	rot=${choice##*|}
	xrandr --output "$out" --rotate "$rot" || { msg "could not rotate $out"; return 1; }
	save_layout >/dev/null
}

arrange_outputs() {
	local choice first out list
	list=$(outputs)
	[[ -n $list ]] || { msg "no connected displays"; return 1; }
	choice=$(printf '%s\n' \
		"Extend: side by side|extend" \
		"Mirror: show the same picture on all|mirror" \
		"Only one display…|only" \
		"Automatic (xrandr --auto)|auto" | "$MENU" "arrange displays") || return 0
	case $choice in
		*'|extend')
			first=""
			while IFS= read -r out; do
				[[ -n $out ]] || continue
				if [[ -z $first ]]; then
					xrandr --output "$out" --auto --primary || return 1
					first=$out
				else
					xrandr --output "$out" --auto --right-of "$first" || return 1
				fi
			done <<< "$list"
			save_layout >/dev/null
			;;
		*'|mirror')
			first=$(printf '%s\n' "$list" | head -n1)
			xrandr --output "$first" --auto --primary || return 1
			while IFS= read -r out; do
				[[ -n $out && $out != "$first" ]] || continue
				xrandr --output "$out" --auto --same-as "$first" || return 1
			done <<< "$list"
			save_layout >/dev/null
			;;
		*'|only')
			out=$(pick_output "only this display") || return 0
			while IFS= read -r first; do
				[[ -n $first ]] || continue
				if [[ $first == "$out" ]]; then
					xrandr --output "$first" --auto --primary || return 1
				else
					xrandr --output "$first" --off || return 1
				fi
			done <<< "$list"
			save_layout >/dev/null
			;;
		*'|auto')
			xrandr --auto || return 1
			save_layout >/dev/null
			;;
	esac
}

menu() {
	local choice
	while :; do
		choice=$(printf '%s\n' \
			"$(summary)" \
			"Change resolution / refresh rate…" \
			"Set primary display…" \
			"Rotate a display…" \
			"Arrange displays…" \
			"Save this layout for login" \
			"Reset to automatic (xrandr --auto)" \
			"Back" | "$MENU" "display settings")
		case $choice in
			'') return 0 ;;
			*'resolution / refresh'*) change_mode ;;
			*'primary display'*) set_primary ;;
			*'Rotate a display'*) rotate_output ;;
			*'Arrange displays'*) arrange_outputs ;;
			*'Save this layout'*) save_layout ;;
			*'Reset to automatic'*) xrandr --auto && save_layout ;;
			*'Back') return 0 ;;
		esac
	done
}

case ${1:-menu} in
	menu|pick) have_xrandr || { msg "xrandr or DISPLAY is missing"; exit 1; }; menu ;;
	status) have_xrandr || { echo "dwm-display: xrandr or DISPLAY is missing" >&2; exit 1; }; summary ;;
	apply) apply_layout ;;
	save) have_xrandr || { msg "xrandr or DISPLAY is missing"; exit 1; }; save_layout ;;
	reset) have_xrandr || { msg "xrandr or DISPLAY is missing"; exit 1; }; xrandr --auto && save_layout ;;
	*)
		sed -n '2,15p' "$0" | sed 's/^# \{0,1\}//'
		exit 1
		;;
esac
