; polybar bar - generated by dwm-bar from this template (polybar/config.ini.in in the repo).
; Change the look with `dwm-bar` (Super+Shift+B), not by editing the installed copy: it is
; rewritten whenever you change the bar style. Colors come from colors.ini (dwm-theme).
; Click the brush to pick a theme, the picture to pick a wallpaper
; (right-click the picture for a random one, middle-click for live wallpapers).
include-file = @HOME@/.config/polybar/colors.ini

[bar/main]
width = @WIDTH@
height = @HEIGHT@
offset-x = @OFFX@
offset-y = @OFFY@
bottom = @BOTTOM@
override-redirect = true
fixed-center = true
background = ${colors.bg}
foreground = ${colors.fg}
@BORDER@
padding-left = @PAD@
padding-right = @PAD@
module-margin = @MARGIN@
font-0 = "JetBrainsMono Nerd Font:size=@FONT@;3"
modules-left = @LEFT@
modules-center = @CENTER@
modules-right = @RIGHT@
enable-ipc = true
cursor-click = pointer

; CPU: busy threads out of total threads (script), RAM and disk: used / total
[module/cpu]
type = custom/script
exec = @HOME@/.local/bin/dwm-cpu
tail = true
format-prefix = "@I_CPU@"
format-prefix-foreground = ${colors.blue}

[module/memory]
type = internal/memory
interval = 3
format-prefix = "@I_RAM@"
format-prefix-foreground = ${colors.magenta}
label = %gb_used%/%gb_total%

[module/fs]
type = internal/fs
interval = 30
mount-0 = /
format-mounted = <label-mounted>
format-mounted-prefix = "@I_DISK@"
format-mounted-prefix-foreground = ${colors.yellow}
label-mounted = %used%/%total%
label-unmounted = n/a

[module/temp]
type = internal/temperature
interval = 3
warn-temperature = 80
format = <label>
format-prefix = "@I_TEMP@"
format-prefix-foreground = ${colors.green}
format-warn = <label-warn>
format-warn-prefix = "@I_TEMP@"
format-warn-prefix-foreground = ${colors.red}
label = %temperature-c%
label-warn = %temperature-c%
label-warn-foreground = ${colors.red}

[module/uptime]
type = custom/script
exec = uptime -p | sed 's/^up //'
interval = 60
format-prefix = "@I_UP@"
format-prefix-foreground = ${colors.cyan}

[module/net]
type = internal/network
interface-type = wireless
interval = 2
format-connected = <label-connected>
label-connected = ↓ %downspeed:8% ↑ %upspeed:8%
format-disconnected = <label-disconnected>
label-disconnected = offline
label-disconnected-foreground = ${colors.red}

[module/wall]
type = custom/text
content = "@I_WALL@@WALL_LABEL@"
content-foreground = ${colors.fg-dim}
click-left = @HOME@/.local/bin/dwm-wall pick
click-right = @HOME@/.local/bin/dwm-wall random
click-middle = @HOME@/.local/bin/dwm-live pick

[module/theme]
type = custom/script
exec = cat @HOME@/.config/dwm-theme/name 2>/dev/null
interval = 10
format-prefix = "@I_THEME@"
format-prefix-foreground = ${colors.accent}
click-left = @HOME@/.local/bin/dwm-theme pick
click-right = @HOME@/.local/bin/dwm-bar pick
