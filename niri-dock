#!/usr/bin/env bash
# niri-dock - the compact application dock at the bottom of the niri screen.
#
# The dock is a small waybar bar (generated config) with app icons on both
# sides of a launcher button in the middle. This is the niri version of
# dwm-dock.
#
#   niri-dock start            generate + start the dock (runs at login)
#   niri-dock restart          regenerate + restart the dock
#   niri-dock toggle           show/hide the dock
#   niri-dock menu             run / pin / unpin applications (Super+P)
#   niri-dock pin <app.desktop>
#   niri-dock unpin <app.desktop>
#   niri-dock generate         only regenerate ~/.config/waybar/config-bottom.jsonc
#
# Pinned apps are stored in ~/.config/niri/dock-apps (one .desktop file per
# line). Click the launcher to run an app or pin/unpin one; right-click an
# icon to unpin it.
set -u
export PATH="$HOME/.local/bin:$PATH"

CONF="${XDG_CONFIG_HOME:-$HOME/.config}"
APPS="$CONF/niri/dock-apps"
CFG="$CONF/waybar/config-bottom.jsonc"
STYLE="$CONF/waybar/style-bottom.css"
GEN_STYLE="$CONF/waybar/gen/style-bottom.css"   # scaled by niri-size (bar and dock size setting)
PATTERN='waybar.*config-bottom\.jsonc'
GTK_PATTERN='(^|/)le-dock( |$)'      # the macOS-style GTK dock (le-dock)
LOG="${XDG_STATE_HOME:-$HOME/.local/state}/le-dwm/dock.log"

say() { printf '%s\n' "$*"; }
warn() { echo "niri-dock: $*" >&2; }

# ---------------------------------------------------------------- pick menus

menu() {
	local prompt=$1 input
	shift
	if (( $# > 0 )); then
		input=$(printf '%s\n' "$@")
	else
		input=$(cat)
	fi
	[[ -n $input ]] || return 1
	printf '%s\n' "$input" | niri-menu -p "$prompt" --lines 12
}

# ---------------------------------------------------------------- dock config

# every directory that can hold .desktop files (also NixOS and Flatpak locations)
app_dirs() {
	local d IFS=:
	for d in "${XDG_DATA_HOME:-$HOME/.local/share}" ${XDG_DATA_DIRS:-/usr/local/share:/usr/share} \
		/run/current-system/sw/share "$HOME/.nix-profile/share" "/etc/profiles/per-user/${USER:-$(id -un)}/share" \
		/var/lib/flatpak/exports/share "$HOME/.local/share/flatpak/exports/share"; do
		[[ -d $d/applications ]] && printf '%s\n' "$d/applications"
	done
	return 0
}


seed_apps() {
	[[ -s $APPS ]] && return
	mkdir -p "$(dirname "$APPS")"
	: > "$APPS"
	local c f
	for c in kitty.desktop firefox.desktop thunar.desktop code-oss.desktop code.desktop; do
		for f in $(app_dirs); do
			if [[ -r $f/$c ]]; then
				echo "$c" >> "$APPS"
				break
			fi
		done
	done
}

generate() {
	seed_apps
	mkdir -p "$(dirname "$CFG")"
	local scale
	scale=$(niri-size scale 2>/dev/null || "$HOME/.local/bin/niri-size" scale 2>/dev/null || echo 1.0)
	python3 - "$APPS" "$CFG" "$scale" <<'PY' || return 1
import json
import os
import re
import shlex
import sys

apps_file, cfg_file = sys.argv[1], sys.argv[2]
try:
    SCALE = float(sys.argv[3])
except (IndexError, ValueError):
    SCALE = 1.0


def sc(v):
    return max(1, int(v * SCALE + 0.5))

def data_dirs():
    """XDG data dirs plus the NixOS, Flatpak and per-user locations."""
    home = os.path.expanduser("~")
    cand = [os.environ.get("XDG_DATA_HOME") or home + "/.local/share"]
    cand += (os.environ.get("XDG_DATA_DIRS") or "/usr/local/share:/usr/share").split(":")
    cand += ["/run/current-system/sw/share", home + "/.nix-profile/share",
             "/etc/profiles/per-user/" + os.environ.get("USER", "") + "/share",
             "/var/lib/flatpak/exports/share", home + "/.local/share/flatpak/exports/share"]
    out = []
    for d in cand:
        if d and d not in out:
            out.append(d)
    return out

dirs = [d + "/applications" for d in data_dirs()]

GLYPHS = [
    (("kitty", "alacritty", "terminal", "konsole", "xterm", "foot"), "\uf120"),
    (("firefox", "chromium", "chrome", "brave", "browser", "web", "epiphany"), "\uf269"),
    (("thunar", "nautilus", "dolphin", "files", "pcmanfm", "nemo"), "\uf07b"),
    (("code", "vscode", "vscodium", "editor", "nvim", "vim", "cursor"), "\uf121"),
    (("discord", "chat", "telegram", "signal", "slack", "element"), "\uf086"),
    (("music", "spotify", "audacious", "rhythmbox", "mpv"), "\uf001"),
    (("video", "vlc", "player", "celluloid"), "\uf008"),
    (("game", "steam", "lutris"), "\uf11b"),
    (("settings", "control", "pavucontrol", "blueman"), "\uf013"),
]

def find_desktop(base):
    for d in dirs:
        path = os.path.join(d, base)
        if os.path.isfile(path):
            return path
    return None

ICON_ROOTS = [d + "/icons" for d in data_dirs()] + [d + "/pixmaps" for d in data_dirs()]
SIZES = ["256x256", "128x128", "96x96", "64x64", "48x48", "512x512", "scalable"]

def find_icon(icon):
    """Return a file path for an Icon= value, or None."""
    if not icon:
        return None
    if os.path.isabs(icon):
        return icon if os.path.isfile(icon) else None
    exts = (".png", ".svg", ".xpm")
    for root in ICON_ROOTS:
        if root.endswith("pixmaps"):
            for ext in exts:
                p = os.path.join(root, icon + ext)
                if os.path.isfile(p):
                    return p
            continue
        try:
            themes = sorted(os.listdir(root))
        except OSError:
            continue
        themes = sorted(themes, key=lambda t: (t != "hicolor", t))
        for theme in themes:
            for size in SIZES:
                for ext in (".png", ".svg"):
                    p = os.path.join(root, theme, size, "apps", icon + ext)
                    if os.path.isfile(p):
                        return p
    return None

def parse_desktop(path):
    name = exec_cmd = icon = None
    in_main = False
    try:
        with open(path, encoding="utf-8", errors="replace") as fh:
            for raw in fh:
                line = raw.rstrip("\n")
                if line.startswith("["):
                    in_main = line.strip() == "[Desktop Entry]"
                    continue
                if not in_main or "=" not in line:
                    continue
                key, value = line.split("=", 1)
                if key == "Name" and name is None:
                    name = value.strip()
                elif key == "Exec" and exec_cmd is None:
                    exec_cmd = re.sub(r"%[fFuUdDnNickvm]", "", value).strip()
                elif key == "Icon" and icon is None:
                    icon = value.strip()
    except OSError:
        return None, None, None
    return name, exec_cmd, icon

def glyph_for(name, base):
    haystack = (name or "") + " " + base
    low = haystack.lower()
    for words, glyph in GLYPHS:
        if any(w in low for w in words):
            return glyph
    initial = (name or base or "?").strip()[:1].upper()
    return initial or "\uf111"

entries = []
if os.path.isfile(apps_file):
    with open(apps_file, encoding="utf-8", errors="replace") as fh:
        bases = [ln.strip() for ln in fh if ln.strip() and not ln.startswith("#")]
else:
    bases = []

seen = set()
for base in bases:
    if base in seen:
        continue
    seen.add(base)
    path = find_desktop(base)
    if not path:
        continue
    name, cmd, icon = parse_desktop(path)
    if not cmd:
        continue
    entries.append({
        "base": base,
        "name": name or base.removesuffix(".desktop"),
        "exec": cmd,
        "icon": find_icon(icon),
        "glyph": glyph_for(name, base),
    })

n = len(entries)
ICON = sc(46)                      # icon size in px
CELL = ICON + 4 * sc(5)            # icon + padding + margin on both sides, see style-bottom.css
mods = [f"image#app{i}" if entries[i]["icon"] else f"custom/app{i}" for i in range(n)]
mods.append("custom/sep")
mods.append("custom/launcher")
width = n * CELL + 2 * sc(14) + sc(14) + CELL + sc(12)

config = {
    "layer": "top",
    "position": "bottom",
    "height": ICON + sc(22),
    "width": width,
    "margin-bottom": sc(10),
    "spacing": 0,
    "modules-center": mods,
    "custom/sep": {"format": "", "tooltip": False},
    "custom/launcher": {
        "format": "\U000f003b",
        "tooltip": True,
        "tooltip-format": "Apps",
        "on-click": "niri-dock menu",
        "on-click-right": "niri-dock menu",
    },
}

for i, entry in enumerate(entries):
    common = {
        "tooltip": True,
        "tooltip-format": entry["name"],
        "on-click": entry["exec"],
        "on-click-right": "niri-dock unpin " + shlex.quote(entry["base"]),
    }
    if entry["icon"]:
        config[f"image#app{i}"] = dict(common, path=entry["icon"], size=ICON)
    else:
        config[f"custom/app{i}"] = dict(common, format=entry["glyph"])

tmp = cfg_file + ".tmp"
with open(tmp, "w", encoding="utf-8") as fh:
    json.dump(config, fh, indent=2, ensure_ascii=False)
    fh.write("\n")
os.replace(tmp, cfg_file)
print(f"niri-dock: {n} app(s), width {width}px")
PY
}

# ---------------------------------------------------------------- start/stop

running() {
	pgrep -f "$PATTERN" >/dev/null 2>&1 || pgrep -f "$GTK_PATTERN" >/dev/null 2>&1
}

# which dock to run: "gtk" (le-dock: running apps, dots, bounce) when it can work here, else "waybar"
want_gtk_dock() {
	[[ $(niri-size kv get DOCK_ENGINE gtk 2>/dev/null) == waybar ]] && return 1
	command -v le-dock >/dev/null 2>&1 && le-dock --check >/dev/null 2>&1
}

stop() {
	local pid
	for pid in $(pgrep -f "$PATTERN" 2>/dev/null) $(pgrep -f "$GTK_PATTERN" 2>/dev/null); do
		kill "$pid" 2>/dev/null || true
	done
}

start() {
	# the dock can be hidden on its own (niri-bars dock hide); pinning apps must not bring it back
	[[ $(niri-size kv get DOCK on 2>/dev/null) == off ]] && return 0
	if running; then
		return 0
	fi
	if want_gtk_dock; then
		mkdir -p "$(dirname "$LOG")"
		setsid le-dock >>"$LOG" 2>&1 &
		sleep 2
		pgrep -f "$GTK_PATTERN" >/dev/null 2>&1 && return 0
		warn "le-dock stopped right after starting (see $LOG); using the simple waybar dock instead"
	fi
	command -v waybar >/dev/null 2>&1 || { warn "waybar is not installed"; return 1; }
	generate || { warn "could not generate the dock config"; return 1; }
	command -v niri-size >/dev/null 2>&1 && niri-size gen >/dev/null 2>&1
	local style=$STYLE
	[[ -r $GEN_STYLE ]] && style=$GEN_STYLE
	[[ -r $style ]] || warn "missing $style (waybar will use its default style)"
	setsid waybar -c "$CFG" -s "$style" >/dev/null 2>&1 &
}

# ---------------------------------------------------------------- actions

pin_app() {
	local base=${1:-}
	[[ -n $base ]] || { warn "usage: niri-dock pin <app.desktop>"; return 1; }
	[[ $base == *.desktop ]] || base="$base.desktop"
	mkdir -p "$(dirname "$APPS")"
	grep -qxF "$base" "$APPS" 2>/dev/null || printf '%s\n' "$base" >> "$APPS"
}

unpin_app() {
	local base=${1:-}
	[[ -n $base ]] || { warn "usage: niri-dock unpin <app.desktop>"; return 1; }
	[[ -s $APPS ]] || return 0
	grep -vxF "$base" "$APPS" > "$APPS.tmp" || true
	mv "$APPS.tmp" "$APPS"
}

list_desktops() {
	python3 - <<'PY'
import os, re
def data_dirs():
    """XDG data dirs plus the NixOS, Flatpak and per-user locations."""
    home = os.path.expanduser("~")
    cand = [os.environ.get("XDG_DATA_HOME") or home + "/.local/share"]
    cand += (os.environ.get("XDG_DATA_DIRS") or "/usr/local/share:/usr/share").split(":")
    cand += ["/run/current-system/sw/share", home + "/.nix-profile/share",
             "/etc/profiles/per-user/" + os.environ.get("USER", "") + "/share",
             "/var/lib/flatpak/exports/share", home + "/.local/share/flatpak/exports/share"]
    out = []
    for d in cand:
        if d and d not in out:
            out.append(d)
    return out

dirs = [d + "/applications" for d in data_dirs()]
seen = set()
out = []
for d in dirs:
    try:
        names = sorted(os.listdir(d))
    except OSError:
        continue
    for base in names:
        if not base.endswith(".desktop") or base in seen:
            continue
        seen.add(base)
        try:
            with open(os.path.join(d, base), encoding="utf-8", errors="replace") as fh:
                text = fh.read()
        except OSError:
            continue
        if "NoDisplay=true" in text:
            continue
        main = text.split("[Desktop Entry]", 1)
        if len(main) < 2:
            continue
        body = main[1].split("[", 1)[0]
        name = icon = None
        for line in body.splitlines():
            if line.startswith("Name=") and name is None:
                name = line[5:].strip()
            elif line.startswith("Icon=") and icon is None:
                icon = line[5:].strip()
        if name:
            out.append((name, base, icon or ""))
for name, base, icon in sorted(out, key=lambda x: x[0].lower()):
    print(f"{name}\t{base}\t{icon}")
PY
}

app_menu() {
	local choice sel base all name
	choice=$(printf '%s\n' \
		"Run application"$'\t'system-run \
		"Pin application to dock"$'\t'list-add \
		"Unpin application"$'\t'list-remove \
		"Restart dock"$'\t'view-refresh | menu "Dock") || return 0
	case $choice in
		"Run application")
			if command -v fuzzel >/dev/null 2>&1; then
				fuzzel >/dev/null 2>&1 &
			elif command -v rofi >/dev/null 2>&1; then
				rofi -show drun >/dev/null 2>&1 &
			else
				dmenu_run >/dev/null 2>&1 &
			fi
			;;
		"Pin application to dock")
			all=$(list_desktops)
			sel=$(printf '%s\n' "$all" | awk -F'\t' '{ print $1 "\t" $3 }' | menu "Pin") || return 0
			[[ -n ${sel:-} ]] || return 0
			base=$(printf '%s\n' "$all" | awk -F'\t' -v n="$sel" '$1 == n { print $2; exit }')
			[[ -n $base ]] && pin_app "$base"
			;;
		"Unpin application")
			[[ -s $APPS ]] || return 0
			all=$(list_desktops)
			sel=$(while IFS= read -r base; do
				line=$(printf '%s\n' "$all" | awk -F'\t' -v b="$base" '$2 == b { print $1 "\t" $3; exit }')
				printf '%s\n' "${line:-$base}"
			done < "$APPS" | menu "Unpin") || return 0
			[[ -n ${sel:-} ]] || return 0
			base=$(printf '%s\n' "$all" | awk -F'\t' -v n="$sel" '$1 == n { print $2; exit }')
			[[ -n $base ]] && unpin_app "${base:-$sel}"
			;;
		"Restart dock")
			stop
			sleep 0.2
			start
			;;
		*)
			return 0
			;;
	esac

	# regenerate + restart if the running dock needs to show the change
	if [[ $choice == "Pin application to dock" || $choice == "Unpin application" ]]; then
		stop
		sleep 0.2
		start
	fi
}

case "${1:-start}" in
	start)
		start
		;;
	restart)
		stop
		sleep 0.2
		start
		;;
	toggle)
		if running; then
			stop
		else
			start
		fi
		;;
	generate)
		generate
		;;
	menu)
		app_menu
		;;
	pin)
		shift
		pin_app "${1:-}" || exit 1
		stop; sleep 0.2; start
		;;
	unpin)
		shift
		unpin_app "${1:-}" || exit 1
		stop; sleep 0.2; start
		;;
	*)
		warn "usage: niri-dock [start|restart|toggle|generate|menu|pin <app.desktop>|unpin <app.desktop>]"
		exit 1
		;;
esac
