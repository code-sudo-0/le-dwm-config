/* macOS-style dock theme for rofi */
window {
    location: south;
    anchor: south;
    width: 70%;
    margin: 0 0 16px 0;
    border: 1px;
    border-color: rgba(255, 255, 255, 0.15);
    border-radius: 24px;
    background-color: rgba(30, 30, 40, 0.75);
    padding: 12px 16px;
}

mainbox {
    background-color: transparent;
    children: [ "inputbar", "listview" ];
    spacing: 8px;
}

inputbar {
    background-color: transparent;
    text-color: #cdd6f4;
    children: [ "prompt", "entry" ];
    spacing: 8px;
}

prompt {
    background-color: transparent;
    text-color: #89b4fa;
    font: "JetBrainsMono Nerd Font 11";
}

entry {
    background-color: transparent;
    text-color: #cdd6f4;
    placeholder: "Search apps…";
    placeholder-color: #6c7086;
    font: "JetBrainsMono Nerd Font 11";
}

listview {
    background-color: transparent;
    layout: horizontal;
    spacing: 6px;
    lines: 1;
    columns: 0;
    fixed-height: true;
    scrollbar: false;
    flow: horizontal;
}

element {
    background-color: transparent;
    orientation: vertical;
    padding: 6px 8px;
    border-radius: 12px;
    spacing: 4px;
    children: [ "element-icon", "element-text" ];
}

element selected {
    background-color: rgba(137, 180, 250, 0.25);
}

element-icon {
    size: 48px;
    background-color: transparent;
}

element-text {
    background-color: transparent;
    text-color: #cdd6f4;
    font: "JetBrainsMono Nerd Font 9";
    horizontal-align: 0.5;
}
