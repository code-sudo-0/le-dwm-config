# Ayu Mirage palette (sourced by dwm-theme). Copy this file to make your own theme.
NAME="Ayu Mirage"
DARK=1
BG="#1f2430"         # main background (bars, windows)
BG_ALT="#242936"     # raised surfaces
BG_HI="#33415e"      # borders / highlights
FG="#cccac2"         # main text
FG_DIM="#707a8c"     # muted text
ACCENT="#ffcc66"     # selected tag, active border, focus
ACCENT_FG="#1f2430"  # text drawn on top of ACCENT
RED="#ed8274"
GREEN="#a6cc70"
YELLOW="#fad07b"
BLUE="#6dcbfa"
MAGENTA="#cfbafa"
CYAN="#90e1c6"
ICONS="Papirus-Dark"
