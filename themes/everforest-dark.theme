# Everforest Dark palette (sourced by dwm-theme). Copy this file to make your own theme.
NAME="Everforest Dark"
DARK=1
BG="#2d353b"         # main background (bars, windows)
BG_ALT="#343f44"     # raised surfaces
BG_HI="#475258"      # borders / highlights
FG="#d3c6aa"         # main text
FG_DIM="#859289"     # muted text
ACCENT="#a7c080"     # selected tag, active border, focus
ACCENT_FG="#2d353b"  # text drawn on top of ACCENT
RED="#e67e80"
GREEN="#a7c080"
YELLOW="#dbbc7f"
BLUE="#7fbbb3"
MAGENTA="#d699b6"
CYAN="#83c092"
ICONS="Papirus-Dark"
