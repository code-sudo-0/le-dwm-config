# Gruvbox Dark palette (sourced by dwm-theme). Copy this file to make your own theme.
NAME="Gruvbox Dark"
DARK=1
BG="#282828"          # main background (bars, windows)
BG_ALT="#3c3836"      # raised surfaces
BG_HI="#504945"       # borders / highlights
FG="#ebdbb2"          # main text
FG_DIM="#a89984"      # muted text
ACCENT="#d79921"      # selected tag, active border, focus
ACCENT_FG="#282828"   # text drawn on top of ACCENT
RED="#fb4934"
GREEN="#b8bb26"
YELLOW="#fabd2f"
BLUE="#83a598"
MAGENTA="#d3869b"
CYAN="#8ec07c"
ICONS="Papirus-Dark"
