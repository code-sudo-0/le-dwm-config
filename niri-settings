#!/usr/bin/env bash
# niri-settings - one menu for the niri desktop: theme, wallpaper, bar and dock size, display,
# window gaps, rounded corners, terminal opacity, bars, keys.
#
# Open it with Super+Shift+D, the gear on the top bar, or `niri-settings`.
set -u

export PATH="$HOME/.local/bin:$PATH"
CONF="${XDG_CONFIG_HOME:-$HOME/.config}"
NIRI="$CONF/niri"
SETTINGS="$NIRI/settings.conf"     # GAPS=, RADIUS=
KDL="$NIRI/settings.kdl"           # generated from settings.conf, included by config.kdl
KITTY_CONF="$CONF/kitty/kitty.conf"
AUTO="$CONF/dwm-theme/auto-theme"  # shared with dwm
DEFAULT_GAPS=14
DEFAULT_RADIUS=14

msg() {
	echo "niri-settings: $*" >&2
	command -v notify-send >/dev/null 2>&1 && notify-send -a niri-settings "$*" 2>/dev/null
	return 0
}

# every picker goes through niri-menu (themed, with icons); items are "label<TAB>icon"
menu() {   # menu <prompt> [niri-menu options]   (items on stdin) -> chosen label
	local prompt=$1; shift
	niri-menu -p "$prompt" "$@"
}

# ---- saved values

get() {   # get <KEY> <default>
	local v
	v=$(sed -n "s/^$1=//p" "$SETTINGS" 2>/dev/null | tail -n1)
	printf '%s\n' "${v:-$2}"
}

put() {   # put <KEY> <value>
	mkdir -p "$NIRI"
	touch "$SETTINGS"
	grep -v "^$1=" "$SETTINGS" > "$SETTINGS.tmp" || true
	printf '%s=%s\n' "$1" "$2" >> "$SETTINGS.tmp"
	mv "$SETTINGS.tmp" "$SETTINGS"
	write_kdl
}

# gaps and corner radius cannot be changed on the fly by niri, but it reloads config.kdl (and the files it
# includes) when they change, so writing the file is enough.
write_kdl() {
	cat > "$KDL" <<EOK
// generated by niri-settings - do not edit by hand (change values with Super+Shift+D)
layout {
    gaps $(get GAPS $DEFAULT_GAPS)
}

window-rule {
    geometry-corner-radius $(get RADIUS $DEFAULT_RADIUS)
    clip-to-geometry true
}
EOK
}

theme_name() { cat "$NIRI/theme" 2>/dev/null || cat "$CONF/dwm-theme/current" 2>/dev/null || printf 'none'; }
auto_state() { [[ -f $AUTO ]] && printf 'on' || printf 'off'; }
size_name() { niri-size get 2>/dev/null || printf 'normal'; }

kitty_opacity() {
	sed -n 's/^[[:space:]]*background_opacity[[:space:]]*//p' "$KITTY_CONF" 2>/dev/null | tail -n1
}

set_kitty_opacity() {
	local val=$1
	[[ -f $KITTY_CONF ]] || { msg "no kitty.conf (run the installer)"; return 1; }
	if grep -q '^[[:space:]]*background_opacity' "$KITTY_CONF"; then
		sed -i "s/^[[:space:]]*background_opacity.*/background_opacity $val/" "$KITTY_CONF"
	else
		printf '\nbackground_opacity %s\n' "$val" >> "$KITTY_CONF"
	fi
	{ pkill -USR1 -x kitty; pkill -USR1 -x .kitty-wrapped; } 2>/dev/null   # NixOS wraps kitty
	return 0
}

# ---- submenus

mark() {   # mark <current>  (labels on stdin) -> labels with a check on the current one
	awk -v c="$1" -F'\t' '{ printf "%s%s\t%s\n", ($1==c ? "✓ " : "  "), $1, $2 }'
}
unmark() { local x=${1#✓ }; printf '%s\n' "${x#  }"; }

theme_menu() {
	local choice t
	choice=$(printf '%s\n' \
		"Choose a theme"$'\t'preferences-desktop-theme \
		"Auto theme (follow the wallpaper): $(auto_state)"$'\t'preferences-desktop-wallpaper \
		"Theme from the current wallpaper, once"$'\t'image-x-generic \
		"Back"$'\t'go-previous | menu "Theme  [$(theme_name)]" --lines 4) || return 0
	case $choice in
		"Choose a theme") niri-theme pick ;;
		Auto*)
			if [[ -f $AUTO ]]; then niri-wall auto off; else niri-wall auto on; fi
			;;
		"Theme from the current"*)
			t=$(cat "$NIRI/wallpaper" 2>/dev/null)
			if [[ -f $t ]]; then niri-theme from-image "$t" || msg "could not build a theme from $t"
			else msg "no wallpaper set yet"; fi
			;;
	esac
}

wallpaper_menu() {
	local choice
	choice=$(printf '%s\n' \
		"Choose a wallpaper"$'\t'preferences-desktop-wallpaper \
		"Random wallpaper"$'\t'media-playlist-shuffle \
		"Back"$'\t'go-previous | menu "Wallpaper" --lines 3) || return 0
	case $choice in
		"Choose a wallpaper") niri-wall pick ;;
		"Random wallpaper") niri-wall random ;;
	esac
}

size_menu() {   # size_menu <top|dock|both>
	local which=$1 cur choice arg=()
	[[ $which == both ]] || arg=("$which")
	cur=$(niri-size get "${arg[@]}" 2>/dev/null || echo normal)
	choice=$(printf '%s\n' compact small normal large | awk '{print $0"\tview-fullscreen"}' | mark "$cur" \
		| menu "Size: $which" --lines 4) || return 0
	choice=$(unmark "$choice")
	[[ -n $choice ]] && niri-bars size "${arg[@]}" "$choice"
}

onoff() { [[ $(niri-size kv get "$1" on 2>/dev/null) == off ]] && printf 'hidden' || printf 'shown'; }

topbar_menu() {
	local choice
	while :; do
		choice=$(printf '%s\n' \
			"Size                $(niri-size get top)"$'\t'view-fullscreen \
			"Style               $(niri-size style)  (floating or docked)"$'\t'view-list \
			"Show / hide         $(onoff TOP)"$'\t'view-reveal \
			"Back"$'\t'go-previous | menu "Top bar" --lines 4) || return 0
		case $choice in
			Size*) size_menu top ;;
			Style*)
				choice=$(printf '%s\n' \
					"floating"$'\t'view-restore \
					"docked"$'\t'view-fullscreen | mark "$(niri-size style)" | menu "Top bar style  (docked = square, stuck to the top)" --lines 2) || continue
				choice=$(unmark "$choice")
				[[ -n $choice ]] && niri-bars style "$choice"
				;;
			Show*) niri-bars top toggle ;;
			*) return 0 ;;
		esac
	done
}

dock_menu() {
	local choice engine
	while :; do
		engine=$(niri-size kv get DOCK_ENGINE gtk 2>/dev/null)
		choice=$(printf '%s\n' \
			"Size                $(niri-size get dock)"$'\t'view-fullscreen \
			"Spacing             $(niri-size kv get DOCK_SPACING normal 2>/dev/null)"$'\t'format-indent-more \
			"Behavior            $(niri-size kv get DOCK_BEHAVIOR float 2>/dev/null)"$'\t'view-restore \
			"Show / hide         $(onoff DOCK)"$'\t'view-reveal \
			"Look                $([[ $engine == waybar ]] && echo simple || echo macOS)  (running apps, bounce)"$'\t'preferences-desktop-theme \
			"Applications        pin or unpin"$'\t'view-app-grid \
			"Restart the dock"$'\t'view-refresh \
			"Back"$'\t'go-previous | menu "Dock" --lines 6) || return 0
		case $choice in
			Size*) size_menu dock ;;
			Spacing*)
				local cur_sp
				cur_sp=$(niri-size kv get DOCK_SPACING normal 2>/dev/null)
				choice=$(printf '%s\n' \
					"tight"$'\t'format-indent-less "normal"$'\t'format-justify-center \
					"roomy"$'\t'format-indent-more "wide"$'\t'view-fullscreen \
					| mark "$cur_sp" | menu "Dock spacing" --lines 4) || continue
				choice=$(unmark "$choice")
				[[ -n $choice ]] || continue
				niri-size kv set DOCK_SPACING "$choice"
				niri-dock stop 2>/dev/null; sleep 0.3; niri-dock start 2>/dev/null
				;;
			Behavior*)
				local cur_bh
				cur_bh=$(niri-size kv get DOCK_BEHAVIOR float 2>/dev/null)
				choice=$(printf '%s\n' \
					"float"$'\t'view-restore "reserve"$'\t'view-fullscreen "autohide"$'\t'view-reveal \
					| mark "$cur_bh" | menu "Dock: float = over windows, reserve = windows stay above, autohide" --lines 3) || continue
				choice=$(unmark "$choice")
				[[ -n $choice ]] || continue
				niri-size kv set DOCK_BEHAVIOR "$choice"
				niri-dock stop 2>/dev/null; sleep 0.3; niri-dock start 2>/dev/null
				;;
			Show*) niri-bars dock toggle ;;
			Look*)
				choice=$(printf '%s\n' \
					"macOS"$'\t'view-app-grid \
					"simple"$'\t'view-list | mark "$([[ $engine == waybar ]] && echo simple || echo macOS)" \
					| menu "Dock look  (macOS: running apps, dots, bounce)" --lines 2) || continue
				choice=$(unmark "$choice")
				case $choice in
					macOS) niri-size kv set DOCK_ENGINE gtk ;;
					simple) niri-size kv set DOCK_ENGINE waybar ;;
					*) continue ;;
				esac
				niri-dock stop 2>/dev/null; sleep 0.3; niri-dock start 2>/dev/null
				;;
			Applications*) niri-dock menu ;;
			Restart*) niri-dock stop 2>/dev/null; sleep 0.3; niri-dock start 2>/dev/null ;;
			*) return 0 ;;
		esac
	done
}

number_menu() {   # number_menu <prompt> <KEY> <default> <values...>
	local prompt=$1 key=$2 def=$3 cur choice
	shift 3
	cur=$(get "$key" "$def")
	choice=$(printf '%s\n' "$@" | awk '{print $0"\tview-fullscreen"}' | mark "$cur" | menu "$prompt" --lines 7) || return 0
	choice=$(unmark "$choice")
	[[ -n $choice ]] && put "$key" "$choice"
}

opacity_menu() {
	local cur choice
	cur=$(kitty_opacity)
	choice=$(printf '%s\n' 1.0 0.95 0.9 0.85 0.8 0.7 0.6 | awk '{print $0"\tutilities-terminal"}' | mark "$cur" \
		| menu "Terminal opacity" --lines 7) || return 0
	choice=$(unmark "$choice")
	[[ -n $choice ]] && set_kitty_opacity "$choice"
}

# ---- main loop

main() {
	local choice
	while :; do
		choice=$(printf '%s\n' \
			"Theme                 $(theme_name)  (auto: $(auto_state))"$'\t'preferences-desktop-theme \
			"Wallpaper"$'\t'preferences-desktop-wallpaper \
			"Top bar               $(niri-size style), $(niri-size get top), $(onoff TOP)"$'\t'view-list \
			"Dock                  $(niri-size get dock), $(onoff DOCK)"$'\t'view-app-grid \
			"Display               resolution, scale, rotation"$'\t'video-display \
			"Window gaps           $(get GAPS $DEFAULT_GAPS)"$'\t'preferences-system-windows \
			"Rounded corners       $(get RADIUS $DEFAULT_RADIUS)"$'\t'window-new \
			"Terminal opacity      $(kitty_opacity)"$'\t'utilities-terminal \
			"Power menu"$'\t'system-shutdown \
			"Restart dock"$'\t'view-refresh \
			"Restart bars          top bar and dock"$'\t'view-refresh \
			"Key list"$'\t'input-keyboard \
			"Quit"$'\t'application-exit | menu "Settings" --lines 12 --width 46) || return 0
		case $choice in
			Theme*) theme_menu ;;
			Wallpaper*) wallpaper_menu ;;
			"Top bar"*) topbar_menu ;;
			Dock*) dock_menu ;;
			Display*) niri-display ;;
			"Window gaps"*) number_menu "Window gaps" GAPS $DEFAULT_GAPS 0 6 10 14 18 24 ;;
			"Rounded corners"*) number_menu "Corner radius" RADIUS $DEFAULT_RADIUS 0 6 10 14 18 24 ;;
			"Terminal opacity"*) opacity_menu ;;
			"Power menu"*) niri-power ;;
			"Restart dock"*) niri-dock stop 2>/dev/null; sleep 0.3; niri-dock start 2>/dev/null ;;
			"Restart bars"*) niri-bars restart 2>/dev/null ;;
			"Key list"*) niri-keys ;;
			*) return 0 ;;
		esac
	done
}

case ${1:-menu} in
	menu) main ;;
	gen) write_kdl ;;
	*) sed -n '2,5p' "$0" | sed 's/^# \{0,1\}//'; exit 1 ;;
esac
