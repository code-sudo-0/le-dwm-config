#!/usr/bin/env bash
# dwm-theme - change the look of the whole setup at once:
#   dwm bar + borders, polybar, GTK apps (Thunar), alacritty, dmenu.
#
# Usage:
#   dwm-theme pick                 choose a theme from a dmenu list
#   dwm-theme list                 print available themes
#   dwm-theme current              print the active theme
#   dwm-theme set <name> [--no-restart]
#
# Themes are palette files in ~/.config/dwm-theme/themes/*.theme.
# Copy one, edit the colors, and it shows up in the picker.
set -o pipefail

CONF="$HOME/.config/dwm-theme"
THEMES="$CONF/themes"
DWM_SRC="${DWM_SRC:-$HOME/dwm}"
BIN="$HOME/.local/bin"
MARK="generated by dwm-theme"
RESTART=1

mkdir -p "$CONF"

msg() { echo "dwm-theme: $*" >&2; command -v notify-send >/dev/null 2>&1 && notify-send -a dwm-theme "$*" 2>/dev/null; return 0; }

# Write stdin to $1. A file we did not generate is backed up once first.
write_managed() {
	local f=$1
	mkdir -p "$(dirname "$f")"
	if [[ -f $f ]] && ! grep -q "$MARK" "$f" && [[ ! -f $f.bak-dwm-theme ]]; then
		cp "$f" "$f.bak-dwm-theme"
	fi
	cat > "$f"
}

dmenu_themed() {
	local BG="#2e3440" FG="#d8dee9" ACCENT="#88c0d0" ACCENT_FG="#2e3440"
	# shellcheck source=/dev/null
	[[ -r $CONF/current.sh ]] && . "$CONF/current.sh"
	dmenu -i -nb "$BG" -nf "$FG" -sb "$ACCENT" -sf "$ACCENT_FG" \
		-fn "JetBrainsMono Nerd Font:size=11" "$@"
}

gen_dwm() {
	[[ -d $DWM_SRC ]] || return 0
	cat > "$DWM_SRC/colors.h" <<EOF
/* $MARK: $NAME - do not edit, run \`dwm-theme pick\` instead */
static const char col_gray1[]  = "$BG";         /* bar background */
static const char col_gray2[]  = "$BG_HI";      /* inactive border */
static const char col_gray3[]  = "$FG";         /* normal text */
static const char col_gray4[]  = "$ACCENT_FG";  /* selected text */
static const char col_accent[] = "$ACCENT";     /* selected bg / active border */
EOF
}

gen_alacritty() {
	write_managed "$HOME/.config/alacritty/dwm-theme.toml" <<EOF
# $MARK: $NAME
[colors.primary]
background = "$BG"
foreground = "$FG"

[colors.cursor]
text = "$BG"
cursor = "$ACCENT"

[colors.selection]
text = "$ACCENT_FG"
background = "$ACCENT"

[colors.normal]
black = "$BG_HI"
red = "$RED"
green = "$GREEN"
yellow = "$YELLOW"
blue = "$BLUE"
magenta = "$MAGENTA"
cyan = "$CYAN"
white = "$FG"

[colors.bright]
black = "$FG_DIM"
red = "$RED"
green = "$GREEN"
yellow = "$YELLOW"
blue = "$BLUE"
magenta = "$MAGENTA"
cyan = "$CYAN"
white = "$FG"
EOF
}

gen_polybar() {
	write_managed "$HOME/.config/polybar/colors.ini" <<EOF
; $MARK: $NAME
[colors]
bg = $BG
bg-alt = $BG_ALT
bg-hi = $BG_HI
fg = $FG
fg-dim = $FG_DIM
accent = $ACCENT
accent-fg = $ACCENT_FG
red = $RED
green = $GREEN
yellow = $YELLOW
blue = $BLUE
magenta = $MAGENTA
cyan = $CYAN
EOF
}

gen_gtk() {
	local prefer_dark=$DARK
	local icons=${ICONS:-Papirus-Dark}
	local settings
	settings=$(cat <<EOF
# $MARK: $NAME
[Settings]
gtk-theme-name=Adwaita
gtk-icon-theme-name=$icons
gtk-font-name=Sans 10
gtk-cursor-theme-name=Adwaita
gtk-cursor-theme-size=24
gtk-application-prefer-dark-theme=$prefer_dark
EOF
)
	printf '%s\n' "$settings" | write_managed "$HOME/.config/gtk-3.0/settings.ini"
	printf '%s\n' "$settings" | write_managed "$HOME/.config/gtk-4.0/settings.ini"

	# GTK2 apps: icons and font only
	write_managed "$HOME/.gtkrc-2.0" <<EOF
# $MARK: $NAME
gtk-icon-theme-name="$icons"
gtk-font-name="Sans 10"
gtk-cursor-theme-name="Adwaita"
EOF

	# GTK3: recolor the built-in Adwaita theme with the palette
	write_managed "$HOME/.config/gtk-3.0/gtk.css" <<EOF
/* $MARK: $NAME */
@define-color theme_bg_color $BG_ALT;
@define-color theme_fg_color $FG;
@define-color theme_base_color $BG;
@define-color theme_text_color $FG;
@define-color theme_selected_bg_color $ACCENT;
@define-color theme_selected_fg_color $ACCENT_FG;
@define-color theme_hovering_selected_bg_color $ACCENT;
@define-color theme_unfocused_bg_color $BG_ALT;
@define-color theme_unfocused_fg_color $FG_DIM;
@define-color theme_unfocused_base_color $BG;
@define-color theme_unfocused_text_color $FG_DIM;
@define-color theme_unfocused_selected_bg_color $BG_HI;
@define-color theme_unfocused_selected_fg_color $FG;
@define-color bg_color $BG_ALT;
@define-color fg_color $FG;
@define-color base_color $BG;
@define-color text_color $FG;
@define-color selected_bg_color $ACCENT;
@define-color selected_fg_color $ACCENT_FG;
@define-color insensitive_bg_color $BG_ALT;
@define-color insensitive_fg_color $FG_DIM;
@define-color insensitive_base_color $BG;
@define-color borders $BG_HI;
@define-color unfocused_borders $BG_HI;
@define-color content_view_bg $BG;
@define-color warning_color $YELLOW;
@define-color error_color $RED;
@define-color success_color $GREEN;
@define-color link_color $BLUE;
@define-color link_visited_color $MAGENTA;
@define-color tooltip_bg_color $BG_HI;
@define-color tooltip_fg_color $FG;

/* softer, more modern shapes */
button, entry, spinbutton { border-radius: 6px; }
menu, .menu, .popup, popover, popover.background { border-radius: 8px; }
scrollbar slider { border-radius: 8px; }
EOF

	# GTK4 / libadwaita apps
	write_managed "$HOME/.config/gtk-4.0/gtk.css" <<EOF
/* $MARK: $NAME */
@define-color accent_bg_color $ACCENT;
@define-color accent_fg_color $ACCENT_FG;
@define-color accent_color $ACCENT;
@define-color window_bg_color $BG;
@define-color window_fg_color $FG;
@define-color view_bg_color $BG;
@define-color view_fg_color $FG;
@define-color headerbar_bg_color $BG_ALT;
@define-color headerbar_fg_color $FG;
@define-color headerbar_border_color $BG_HI;
@define-color card_bg_color $BG_ALT;
@define-color card_fg_color $FG;
@define-color dialog_bg_color $BG_ALT;
@define-color dialog_fg_color $FG;
@define-color popover_bg_color $BG_ALT;
@define-color popover_fg_color $FG;
@define-color sidebar_bg_color $BG_ALT;
@define-color sidebar_fg_color $FG;
@define-color error_color $RED;
@define-color warning_color $YELLOW;
@define-color success_color $GREEN;
EOF
}

# Rebuild dwm so the new colors.h takes effect. Installs to ~/.local (no sudo).
build_dwm() {
	[[ -f $DWM_SRC/Makefile ]] || return 0
	if make -C "$DWM_SRC" PREFIX="$HOME/.local" clean install >"$CONF/build.log" 2>&1; then
		return 0
	fi
	msg "dwm build failed, see $CONF/build.log"
	return 1
}

restart_polybar() {
	command -v polybar >/dev/null 2>&1 || return 0
	[[ -f $HOME/.config/polybar/config.ini ]] || return 0
	pkill -x polybar 2>/dev/null
	sleep 0.3
	setsid polybar --config="$HOME/.config/polybar/config.ini" bottom >/dev/null 2>&1 &
}

reload() {
	local built=0
	build_dwm && built=1
	[[ -n ${DISPLAY:-} ]] || return 0

	restart_polybar
	# GTK apps only read their theme on start
	pgrep -x thunar >/dev/null 2>&1 && thunar -q 2>/dev/null

	if ((built)) && ((RESTART)) && [[ ${DWM_RESTARTABLE:-} == 1 ]] && pgrep -x dwm >/dev/null 2>&1; then
		# start-dwm relaunches dwm when it is killed; windows reattach to the current tag
		pkill -TERM -x dwm
	elif ((built)) && ((RESTART)); then
		msg "theme applied; log out and back in to recolor the dwm bar"
	fi
}

set_theme() {
	local name=$1 f="$THEMES/$1.theme"
	if [[ ! -f $f ]]; then
		msg "no such theme: $name (see: dwm-theme list)"
		return 1
	fi
	# shellcheck source=/dev/null
	. "$f"
	DARK=${DARK:-1}
	NAME=${NAME:-$name}

	printf '%s\n' "$name" > "$CONF/current"
	printf '%s\n' "$NAME" > "$CONF/name"
	cp "$f" "$CONF/current.sh"

	gen_dwm
	gen_alacritty
	gen_polybar
	gen_gtk
	reload
}

list_themes() {
	local f
	for f in "$THEMES"/*.theme; do
		[[ -e $f ]] && basename "$f" .theme
	done
}

pick() {
	declare -A map
	local list="" f n disp choice cur
	cur=$(cat "$CONF/current" 2>/dev/null)
	for f in "$THEMES"/*.theme; do
		[[ -e $f ]] || continue
		n=$(basename "$f" .theme)
		disp=$( . "$f"; printf '%s' "${NAME:-$n}" )
		map["$disp"]=$n
		list+="$disp"$'\n'
	done
	if [[ -z $list ]]; then
		msg "no themes found in $THEMES"
		return 1
	fi
	choice=$(printf '%s' "$list" | dmenu_themed -l 10 -p "theme (now: ${cur:-none})")
	[[ -n $choice && -n ${map[$choice]:-} ]] && set_theme "${map[$choice]}"
}

# options anywhere on the line
args=()
for a in "$@"; do
	case $a in
		--no-restart) RESTART=0 ;;
		*) args+=("$a") ;;
	esac
done
set -- "${args[@]}"

case ${1:-pick} in
	pick) pick ;;
	list) list_themes ;;
	current) cat "$CONF/current" 2>/dev/null || echo none ;;
	set)
		[[ -n ${2:-} ]] || { echo "usage: dwm-theme set <name>" >&2; exit 1; }
		set_theme "$2"
		;;
	*)
		sed -n '2,13p' "$0" | sed 's/^# \{0,1\}//'
		exit 1
		;;
esac
