#!/bin/sh
# Session launcher for dwm (used by the login-manager entry and ~/.xinitrc).
#
# dwm is relaunched if it is killed, which is how dwm-theme applies new bar
# colors without ending your session. Confirming the Super+Shift+Q prompt
# (dwm-quit) ends the session; a crash within 3 seconds of starting also ends it,
# so a broken build cannot spin forever.
BIN="$HOME/.local/bin"
export PATH="$BIN:$PATH"
export DWM_RESTARTABLE=1

QUIT_FLAG="${XDG_RUNTIME_DIR:-/tmp}/dwm-quit-$(id -u)"
rm -f "$QUIT_FLAG"

[ -r "$HOME/.Xresources" ] && xrdb -merge "$HOME/.Xresources"

PICOM_PID=""
if command -v picom >/dev/null 2>&1 && [ -f "$HOME/.config/picom/picom.conf" ]; then
	picom --config "$HOME/.config/picom/picom.conf" >/dev/null 2>&1 &
	PICOM_PID=$!
fi

"$BIN/dwm-wall" restore &
"$BIN/dwmstatus" &
STATUS_PID=$!

POLY_PID=""
# dwm-bar starts polybar where the chosen layout wants it (or not at all for one-bar layouts)
if [ -x "$BIN/dwm-bar" ] && [ -f "$HOME/.config/polybar/config.ini" ]; then
	"$BIN/dwm-bar" polybar >/dev/null 2>&1 &
	POLY_PID=$!
fi

while :; do
	started=$(date +%s)
	"$BIN/dwm"
	status=$?
	[ "$status" -eq 0 ] && break
	# dwm-quit leaves this flag after you confirm "close dwm"
	if [ -e "$QUIT_FLAG" ]; then rm -f "$QUIT_FLAG"; break; fi
	[ $(( $(date +%s) - started )) -lt 3 ] && break
done

kill "$STATUS_PID" $POLY_PID $PICOM_PID 2>/dev/null
pkill -u "$(id -u)" -x polybar 2>/dev/null
exit 0
