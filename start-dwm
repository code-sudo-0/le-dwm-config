#!/bin/sh
# Session launcher for dwm (used by the login-manager entry and ~/.xinitrc).
#
# dwm is relaunched if it is killed, which is how dwm-theme applies new bar
# colors without ending your session. A normal quit (Super+Shift+Q) exits 0
# and ends the session; a crash within 3 seconds of starting also ends it,
# so a broken build cannot spin forever.
BIN="$HOME/.local/bin"
export PATH="$BIN:$PATH"
export DWM_RESTARTABLE=1

[ -r "$HOME/.Xresources" ] && xrdb -merge "$HOME/.Xresources"

"$BIN/dwm-wall" restore &
"$BIN/dwmstatus" &
STATUS_PID=$!

POLY_PID=""
if command -v polybar >/dev/null 2>&1 && [ -f "$HOME/.config/polybar/config.ini" ]; then
	polybar --config="$HOME/.config/polybar/config.ini" bottom >/dev/null 2>&1 &
	POLY_PID=$!
fi

while :; do
	started=$(date +%s)
	"$BIN/dwm"
	status=$?
	[ "$status" -eq 0 ] && break
	[ $(( $(date +%s) - started )) -lt 3 ] && break
done

kill "$STATUS_PID" $POLY_PID 2>/dev/null
pkill -u "$(id -u)" -x polybar 2>/dev/null
exit 0
