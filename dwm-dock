#!/usr/bin/env bash
# dwm-dock - what Super+P does.
#
#   dock feature off (DOCK=0 in bar.conf): runs dmenu_run, the regular menu.
#   dock feature on  (DOCK=1): toggles a real dock on the desktop - a compact
#   polybar bar of application icons with a launcher in the middle. Press
#   Super+P again to hide it. Click the launcher to run or pin apps.
set -u

CONF="${HOME}/.config/dwm-theme/bar.conf"
DOCKCFG="${HOME}/.config/polybar/dock.ini"
PIDFILE="${XDG_RUNTIME_DIR:-${HOME}/.cache}/dwm-dock.pid"
PINNED="${HOME}/.config/dwm-dock/pinned"

# ---------- helpers ----------

dock_feature() {
	local d=0
	[[ -r $CONF ]] && d=$(sed -n 's/^DOCK=//p' "$CONF" | head -1)
	echo "${d:-0}"
}

ensure_pinned() {
	[[ -f $PINNED ]] && return
	mkdir -p "$(dirname "$PINNED")"
	: > "$PINNED"
	# seed with whatever common apps are installed
	seed() {
		for c in "$@"; do
			local f
			for base in /usr/share/applications "$HOME/.local/share/applications"; do
				f="$base/$c"
				[[ -r $f ]] && { echo "$c" >> "$PINNED"; return 0; }
			done
		done
		return 1
	}
	seed kitty.desktop alacritty.desktop gnome-terminal.desktop konsole.desktop xfce4-terminal.desktop xterm.desktop
	seed firefox.desktop chromium.desktop brave-browser.desktop google-chrome.desktop
	seed thunar.desktop nautilus.desktop dolphin.desktop pcmanfm.desktop
	seed code.desktop code-oss.desktop vscodium.desktop
}

app_name() {
	local f="$1"
	sed -n 's/^Name=//p' "$f" | head -1
}

app_exec() {
	local f="$1"
	local e
	e=$(sed -n 's/^Exec=//p' "$f" | head -1)
	e=${e//%[a-zA-Z]/}
	echo "$e"
}

app_icon() {
	# map an app name to a Nerd Font glyph
	local name=$(echo "$1" | tr '[:upper:]' '[:lower:]')
	case "$name" in
		*kitty*|*alacritty*|*terminal*|*konsole*|*xterm*) echo "" ;;
		*firefox*|*chromium*|*chrome*|*brave*|*browser*|*web*) echo "" ;;
		*thunar*|*nautilus*|*dolphin*|*files*|*pcmanfm*) echo "" ;;
		*code*|*vscode*|*vscodium*|*editor*|*nvim*|*vim*) echo "" ;;
		*settings*|*control*) echo "" ;;
		*) echo "${name:0:1}" | tr '[:lower:]' '[:upper:]' ;;
	esac
}

desktop_path() {
	local base="$1"
	for d in /usr/share/applications "$HOME/.local/share/applications"; do
		[[ -r "$d/$base" ]] && { echo "$d/$base"; return; }
	done
}

generate_dock() {
	ensure_pinned
	local entries=()
	while IFS= read -r line; do
		[[ -n $line ]] || continue
		entries+=("$line")
	done < "$PINNED"

	# split pinned apps around the launcher (left half / right half)
	local n=${#entries[@]}
	local left_count=$(( (n + 1) / 2 ))
	local left_mods="" right_mods=""
	local i=0
	local mods_left="" mods_right=""
	# build module definitions
	local mod_defs=""
	for ((i=0; i<n; i++)); do
		local base="${entries[$i]}"
		local f; f=$(desktop_path "$base")
		[[ -r $f ]] || continue
		local name; name=$(app_name "$f")
		[[ -n $name ]] || name="$base"
		local execmd; execmd=$(app_exec "$f")
		[[ -n $execmd ]] || execmd="gtk-launch ${base%.desktop}"
		local glyph; glyph=$(app_icon "$name")
		local mod="app$i"
		mod_defs+="[module/$mod]"$'\n'
		mod_defs+="type = custom/text"$'\n'
		mod_defs+="content = \"$glyph\""$'\n'
		mod_defs+="content-foreground = \${colors.fg}"$'\n'
		mod_defs+="content-padding = 1"$'\n'
		mod_defs+="click-left = $execmd &"$'\n'
		mod_defs+=$'\n'
		if (( i < left_count )); then
			mods_left+=" $mod"
		else
			mods_right+=" $mod"
		fi
	done

	cat > "$DOCKCFG" <<EOF
; generated by le-dwm-config: compact macOS-style application dock
include-file = ~/.config/polybar/colors.ini

[bar/dock]
monitor = \${env:MONITOR:}
width = 34%
height = 34
offset-x = 33%
offset-y = 6
bottom = true
fixed-center = true
override-redirect = true
radius = 12.0

background = \${colors.bg}
foreground = \${colors.fg}

border-size = 1
border-color = \${colors.bg-hi}

padding-left = 6
padding-right = 6
module-margin = 2

font-0 = "JetBrainsMono Nerd Font:size=16;3"

modules-left =${mods_left}
modules-center = launcher
modules-right =${mods_right}

cursor-click = pointer

[module/launcher]
type = custom/text
content = "󰀻"
content-foreground = \${colors.accent}
content-padding = 1
click-left = dwm-dock --launcher &
click-right = dwm-dock --pin &
EOF
	printf '%s\n' "$mod_defs" >> "$DOCKCFG"
}

# ---------- actions ----------

case "${1:-}" in
	--launcher)
		# menu: run an app, or pin/unpin
		if command -v rofi >/dev/null 2>&1; then
			choice=$(printf '%s\n' "Run application" "Pin application to dock" "Unpin application" | rofi -dmenu -p "Dock")
		else
			choice=$(printf '%s\n' "Run application" "Pin application to dock" "Unpin application" | dmenu -i -p "Dock")
		fi
		case "$choice" in
			"Run application")
				if command -v rofi >/dev/null 2>&1; then rofi -show drun -show-icons; else dmenu_run; fi
				;;
			"Pin application to dock")
				# pick a .desktop app
				list=$(
					for f in /usr/share/applications/*.desktop "$HOME/.local/share/applications"/*.desktop; do
						[[ -r $f ]] || continue
						n=$(sed -n 's/^Name=//p' "$f" | head -1)
						[[ -n $n ]] || continue
						echo "$n|$f"
					done | sort -u
				)
				if command -v rofi >/dev/null 2>&1; then
					sel=$(printf '%s\n' "$list" | cut -d'|' -f1 | rofi -dmenu -p "Pin")
				else
					sel=$(printf '%s\n' "$list" | cut -d'|' -f1 | dmenu -i -p "Pin")
				fi
				[[ -n $sel ]] || exit 0
				base=$(printf '%s\n' "$list" | awk -F'|' -v s="$sel" '$1==s{print $2; exit}')
				bn=$(basename "$base")
				grep -qxF "$bn" "$PINNED" 2>/dev/null || echo "$bn" >> "$PINNED"
				# restart dock if running
				if [[ -f $PIDFILE ]] && kill -0 "$(cat "$PIDFILE" 2>/dev/null)" 2>/dev/null; then
					kill "$(cat "$PIDFILE")" 2>/dev/null
					rm -f "$PIDFILE"
					sleep 0.3
					generate_dock
					setsid polybar -c "$DOCKCFG" dock >/dev/null 2>&1 &
					echo $! > "$PIDFILE"
				fi
				;;
			"Unpin application")
				[[ -s $PINNED ]] || exit 0
				sel=$(cat "$PINNED" | while read -r b; do
					f=$(desktop_path "$b"); n=$(app_name "$f"); echo "${n:-$b}"
				done | sort -u | { if command -v rofi >/dev/null 2>&1; then rofi -dmenu -p "Unpin"; else dmenu -i -p "Unpin"; fi; })
				[[ -n $sel ]] || exit 0
				# map back to basename
				while IFS= read -r b; do
					f=$(desktop_path "$b"); n=$(app_name "$f")
					[[ "${n:-$b}" == "$sel" ]] && echo "$b"
				done < "$PINNED" | head -1 > /tmp/opencode/unpin.txt
				target=$(cat /tmp/opencode/unpin.txt 2>/dev/null)
				[[ -n $target ]] && grep -vxF "$target" "$PINNED" > "$PINNED.tmp" && mv "$PINNED.tmp" "$PINNED"
				if [[ -f $PIDFILE ]] && kill -0 "$(cat "$PIDFILE" 2>/dev/null)" 2>/dev/null; then
					kill "$(cat "$PIDFILE")" 2>/dev/null
					rm -f "$PIDFILE"
					sleep 0.3
					generate_dock
					setsid polybar -c "$DOCKCFG" dock >/dev/null 2>&1 &
					echo $! > "$PIDFILE"
				fi
				;;
		esac
		exit 0
		;;
	--pin)
		# dwm-dock --pin <desktop-file-basename>
		[[ -n ${2:-} ]] && { grep -qxF "$2" "$PINNED" 2>/dev/null || echo "$2" >> "$PINNED"; }
		exit 0
		;;
esac

# ---------- toggle (default) ----------

feature=$(dock_feature)
if [[ $feature != 1 ]]; then
	if command -v dmenu_run >/dev/null 2>&1; then
		exec dmenu_run
	elif command -v rofi >/dev/null 2>&1; then
		exec rofi -show run
	else
		command -v notify-send >/dev/null 2>&1 && notify-send -a dwm "No menu found" "Install dmenu or rofi."
		exit 1
	fi
fi

if [[ -f $PIDFILE ]] && kill -0 "$(cat "$PIDFILE" 2>/dev/null)" 2>/dev/null; then
	kill "$(cat "$PIDFILE")" 2>/dev/null
	rm -f "$PIDFILE"
	exit 0
fi

ensure_pinned
generate_dock
setsid polybar -c "$DOCKCFG" dock >/dev/null 2>&1 &
echo $! > "$PIDFILE"
