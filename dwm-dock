#!/usr/bin/env bash
# dwm-dock - what Super+P does.
#
#   dock feature off (DOCK=0 in bar.conf): runs dmenu_run, the regular menu.
#   dock feature on  (DOCK=1): toggles a real dock on the desktop - a polybar
#   bar of application icons (terminal, web, files, code, settings) with a
#   launcher button. Press Super+P again to hide it.
#
# Toggle the feature with `dwm-bar` (Super+Shift+B -> Dock) or
# `dwm-bar set DOCK=1`. Super+P always calls this script, so the binding in
# dwm's config.h never has to change.
set -u

CONF="${HOME}/.config/dwm-theme/bar.conf"
DOCKCFG="${HOME}/.config/polybar/dock.ini"
PIDFILE="${XDG_RUNTIME_DIR:-${HOME}/.cache}/dwm-dock.pid"

dock=0
if [[ -r $CONF ]]; then
	dock=$(sed -n 's/^DOCK=//p' "$CONF" | head -1)
fi
dock="${dock:-0}"

# feature off -> regular menu
if [[ $dock != 1 ]]; then
	if command -v dmenu_run >/dev/null 2>&1; then
		exec dmenu_run
	elif command -v rofi >/dev/null 2>&1; then
		exec rofi -show run
	else
		command -v notify-send >/dev/null 2>&1 && notify-send -a dwm "No menu found" "Install dmenu or rofi."
		exit 1
	fi
fi

# feature on -> toggle the real dock
if [[ -f $PIDFILE ]] && kill -0 "$(cat "$PIDFILE" 2>/dev/null)" 2>/dev/null; then
	# hide
	kill "$(cat "$PIDFILE")" 2>/dev/null
	rm -f "$PIDFILE"
	exit 0
fi

if [[ ! -r $DOCKCFG ]]; then
	command -v notify-send >/dev/null 2>&1 && notify-send -a dwm "Dock config missing" "Run the installer to create ~/.config/polybar/dock.ini."
	exit 1
fi

# show
setsid polybar -c "$DOCKCFG" dock >/dev/null 2>&1 &
echo $! > "$PIDFILE"
