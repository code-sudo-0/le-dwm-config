// le-dwm-config - niri config that mirrors the dwm setup.
//
// The dwm install is still the default; this file gives the same feel on
// Wayland: Super as the modifier, 14 px gaps, 2 px focus ring, a floating top
// status bar and a compact floating dock at the bottom.
//
// Colors are generated from the same theme files as dwm (niri-theme).
// Reload after edits: niri picks the config up automatically when you save it.

include optional=true "colors.kdl"

// Ask apps to drop client-side decorations so the focus ring and rounded
// corners are drawn by niri, like dwm's border.
prefer-no-csd

input {
    keyboard {
        xkb {
            layout "us"
        }
        numlock
        repeat-delay 600
        repeat-rate 25
    }

    touchpad {
        tap
        natural-scroll
        dwt
    }
}

layout {
    // room between windows, screen edges and the floating bars
    gaps 14
    center-focused-column "never"
    always-center-single-column

    // Two windows side by side, like dwm's master/stack split.
    default-column-width { proportion 0.5; }
    preset-column-widths {
        proportion 0.33333
        proportion 0.5
        proportion 0.66667
    }
    preset-window-heights {
        proportion 0.33333
        proportion 0.5
        proportion 0.66667
    }

    // dwm draws a 2 px border; a focus ring looks the same but only around
    // the focused window. Colors come from ~/.config/niri/colors.kdl.
    focus-ring {
        width 2
    }
    border {
        off
    }

    shadow {
        on
        softness 24
        spread 2
        offset x=0 y=5
        color "#00000055"
    }
}

// Floating bars: waybar on top (workspaces, window, clock, status) and a
// compact dock at the bottom generated by niri-dock.
spawn-at-startup "sh" "-c" "PATH=$HOME/.local/bin:$PATH niri-wall restore"
spawn-at-startup "sh" "-c" "PATH=$HOME/.local/bin:$PATH niri-bars start"
spawn-at-startup "mako"

hotkey-overlay {
    skip-at-startup
}

screenshot-path "~/Pictures/Screenshots/niri %Y-%m-%d %H-%M-%S.png"

// Floating apps, mirroring dwm's rules array.
window-rule {
    match app-id=r#"^gimp"#
    open-floating true
}

window-rule {
    match app-id=r#"(?i)pavucontrol"#
    open-floating true
}

window-rule {
    match app-id=r#"firefox$"# title="^Picture-in-Picture$"
    open-floating true
}

// Rounded windows, like the picom corners in dwm.
window-rule {
    geometry-corner-radius 14
    clip-to-geometry true
}

binds {
    // ---- windows and workspaces ----------------------------------------
    Mod+Return hotkey-overlay-title="Terminal: kitty" { spawn "kitty"; }
    Mod+W hotkey-overlay-title="Web: Firefox" { spawn "firefox"; }
    Mod+E hotkey-overlay-title="Files: Thunar" { spawn "thunar"; }
    Mod+P hotkey-overlay-title="Launcher / dock" { spawn-sh "PATH=$HOME/.local/bin:$PATH niri-dock menu"; }

    Mod+J { focus-window-down; }
    Mod+K { focus-window-up; }
    Mod+H { set-column-width "-5%"; }
    Mod+L { set-column-width "+5%"; }

    // dwm's incnmaster / decnmaster: cycle the column width presets.
    Mod+I { switch-preset-column-width; }
    Mod+D { switch-preset-column-width-back; }

    // dwm's zoom / killclient.
    Mod+Shift+Return { maximize-column; }
    Mod+Shift+C { close-window; }
    Mod+Tab { focus-workspace-previous; }

    // dwm layouts: tile, float, monocle, cycle.
    Mod+T { switch-preset-column-width; }
    Mod+F { toggle-window-floating; }
    Mod+M { maximize-column; }
    Mod+Space { switch-preset-column-width; }
    Mod+Shift+Space { toggle-window-floating; }

    // Columns, like the stack.
    Mod+BracketLeft { consume-or-expel-window-left; }
    Mod+BracketRight { consume-or-expel-window-right; }
    Mod+0 { toggle-overview; }

    // Monitors.
    Mod+Comma { focus-monitor-left; }
    Mod+Period { focus-monitor-right; }
    Mod+Shift+Comma { move-column-to-monitor-left; }
    Mod+Shift+Period { move-column-to-monitor-right; }

    // Workspaces 1-9, like tags.
    Mod+1 { focus-workspace 1; }
    Mod+2 { focus-workspace 2; }
    Mod+3 { focus-workspace 3; }
    Mod+4 { focus-workspace 4; }
    Mod+5 { focus-workspace 5; }
    Mod+6 { focus-workspace 6; }
    Mod+7 { focus-workspace 7; }
    Mod+8 { focus-workspace 8; }
    Mod+9 { focus-workspace 9; }
    Mod+Shift+1 { move-column-to-workspace 1; }
    Mod+Shift+2 { move-column-to-workspace 2; }
    Mod+Shift+3 { move-column-to-workspace 3; }
    Mod+Shift+4 { move-column-to-workspace 4; }
    Mod+Shift+5 { move-column-to-workspace 5; }
    Mod+Shift+6 { move-column-to-workspace 6; }
    Mod+Shift+7 { move-column-to-workspace 7; }
    Mod+Shift+8 { move-column-to-workspace 8; }
    Mod+Shift+9 { move-column-to-workspace 9; }

    Mod+Page_Down { focus-workspace-down; }
    Mod+Page_Up { focus-workspace-up; }
    Mod+Ctrl+Page_Down { move-column-to-workspace-down; }
    Mod+Ctrl+Page_Up { move-column-to-workspace-up; }
    Mod+WheelScrollDown cooldown-ms=150 { focus-workspace-down; }
    Mod+WheelScrollUp cooldown-ms=150 { focus-workspace-up; }
    Mod+WheelScrollRight { focus-column-right; }
    Mod+WheelScrollLeft { focus-column-left; }

    // ---- system --------------------------------------------------------
    Mod+B { spawn-sh "pkill -USR1 -x waybar; pkill -USR1 -x .waybar-wrapped"; }
    Mod+Shift+B { spawn-sh "PATH=$HOME/.local/bin:$PATH niri-bars menu"; }
    Mod+Shift+D hotkey-overlay-title="Settings menu" { spawn-sh "PATH=$HOME/.local/bin:$PATH niri-settings"; }
    Mod+Shift+T { spawn-sh "PATH=$HOME/.local/bin:$PATH niri-theme pick"; }
    Mod+Shift+W { spawn-sh "PATH=$HOME/.local/bin:$PATH niri-wall pick"; }
    Mod+Ctrl+W { spawn-sh "PATH=$HOME/.local/bin:$PATH niri-wall random"; }
    Mod+Shift+S { screenshot; }
    Mod+Shift+Slash hotkey-overlay-title="Show every key" { spawn-sh "PATH=$HOME/.local/bin:$PATH niri-keys"; }
    Mod+Shift+Q { quit; }
    Print { screenshot-screen; }

    XF86AudioRaiseVolume allow-when-locked=true { spawn-sh "wpctl set-volume @DEFAULT_AUDIO_SINK@ 5%+ -l 1.0"; }
    XF86AudioLowerVolume allow-when-locked=true { spawn-sh "wpctl set-volume @DEFAULT_AUDIO_SINK@ 5%-"; }
    XF86AudioMute allow-when-locked=true { spawn-sh "wpctl set-mute @DEFAULT_AUDIO_SINK@ toggle"; }
    XF86AudioMicMute allow-when-locked=true { spawn-sh "wpctl set-mute @DEFAULT_AUDIO_SOURCE@ toggle"; }
    XF86MonBrightnessUp allow-when-locked=true { spawn "brightnessctl" "set" "5%+"; }
    XF86MonBrightnessDown allow-when-locked=true { spawn "brightnessctl" "set" "5%-"; }
}

// Saved choices from the settings menu (Super+Shift+D). They come last so they override the values above.
include optional=true "settings.kdl"
include optional=true "display.kdl"
include "settings/gaps.kdl"
include "settings/corners.kdl"
include "settings/theme.kdl"
