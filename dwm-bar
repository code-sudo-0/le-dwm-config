#!/usr/bin/env python3
"""dwm-bar - bar layouts, floating bars, icon sets and rounded windows.

  dwm-bar                      open the style menu (Super+Shift+B, or right-click the theme button)
  dwm-bar preset <name>        apply a preset: default classic floating minimal dock stacked compact plain
  dwm-bar presets              list the presets
  dwm-bar set KEY=VALUE...     change single options (see `dwm-bar status` for the keys)
  dwm-bar status               show the current style
  dwm-bar apply                regenerate everything from bar.conf and reload
  dwm-bar gen                  regenerate the files only (used by the installer)
  dwm-bar init                 create bar.conf if missing (installer; honors BAR_PRESET, BAR_OPACITY, ANIMATIONS)
  dwm-bar polybar              run polybar for the current layout (used by start-dwm)

Options live in ~/.config/dwm-theme/bar.conf:
  LAYOUT   split | split-flip | stack-top | stack-bottom | single-top | single-bottom
  FLOAT    1 = bars float (gap + rounded), 0 = edge to edge
  GAP      px: gap between windows, and the float margin of the bars
  RADIUS   px: rounded corners of windows (and of floating bars); 0 = square
  WIDTH    polybar: full | compact (centered, 70% wide)
  DENSITY  polybar: normal | compact (shorter, smaller text)
  ICONS    nerd | alt | dots | text
  TAGS     config (as in your config.h) | icons | alt | numbers | roman
  CAT      1 | 0   the running cat in the top bar
  RES      auto | 1 | 0   CPU/RAM/disk in the top bar (auto: only when there is no second bar)
  BAR_OPACITY  10-100, ANIMATIONS 0|1

dwm itself needs a rebuild + restart (about a second) when the geometry or tags change.
"""
import os
import re
import shutil
import subprocess
import sys

