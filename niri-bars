#!/usr/bin/env bash
# niri-bars - start, restart or toggle the two floating waybar bars.
#
#   niri-bars start      start the top status bar and the bottom dock
#   niri-bars restart    restart both bars
#   niri-bars toggle     show/hide both bars (Super+B)
#   niri-bars dock hide|show|toggle   hide only the dock (Super+Ctrl+B)
#   niri-bars top hide|show|toggle    hide only the top bar (Super+Alt+B)
#   niri-bars style floating|docked   top bar: rounded with a gap, or square and stuck to the top edge
#   niri-bars menu       small menu (Super+Shift+B)
#   niri-bars size [compact|small|normal|large]   show or change the bar and dock size
set -u

CONF="${XDG_CONFIG_HOME:-$HOME/.config}"
TOP_CFG="$CONF/waybar/config-top.jsonc"
TOP_STYLE="$CONF/waybar/style-top.css"
TOP_PATTERN='waybar.*config-top\.jsonc'
export PATH="$HOME/.local/bin:$PATH"

say() { printf '%s\n' "$*"; }
warn() { echo "niri-bars: $*" >&2; }

top_running() {
	pgrep -f "$TOP_PATTERN" >/dev/null 2>&1
}

# scaled copies of the bar files for the chosen size (niri-size), used when they exist
size_gen() {
	command -v niri-size >/dev/null 2>&1 && niri-size gen >/dev/null 2>&1
	if [[ -r $CONF/waybar/gen/config-top.jsonc && -r $CONF/waybar/gen/style-top.css ]]; then
		TOP_CFG="$CONF/waybar/gen/config-top.jsonc"
		TOP_STYLE="$CONF/waybar/gen/style-top.css"
	fi
}

start_top() {
	if top_running; then
		return 0
	fi
	size_gen
	if [[ ! -r $TOP_CFG ]]; then
		warn "missing $TOP_CFG (run the installer)"
		return 1
	fi
	command -v waybar >/dev/null 2>&1 || { warn "waybar is not installed"; return 1; }
	setsid waybar -c "$TOP_CFG" -s "$TOP_STYLE" >/dev/null 2>&1 &
}

flag() { niri-size kv get "$1" on 2>/dev/null || echo on; }   # DOCK / TOP: on or off

start_all() {
	[[ $(flag TOP) == off ]] || start_top
	[[ $(flag DOCK) == off ]] && return 0
	niri-dock start 2>/dev/null || "$HOME/.local/bin/niri-dock" start 2>/dev/null || warn "could not start the dock"
}

restart_all() {
	pkill -x waybar 2>/dev/null; pkill -x .waybar-wrapped 2>/dev/null
	niri-dock stop 2>/dev/null
	sleep 0.3
	start_all
}

# hide or show one bar and remember it (the flag survives restarts and pinning apps)
set_bar() {   # set_bar dock|top hide|show|toggle
	local which=$1 act=$2 key cur
	[[ $which == dock ]] && key=DOCK || key=TOP
	cur=$(flag "$key")
	case $act in
		toggle) [[ $cur == off ]] && act=show || act=hide ;;
		hide|show) ;;
		*) warn "usage: niri-bars $which hide|show|toggle"; return 1 ;;
	esac
	if [[ $act == hide ]]; then
		niri-size kv set "$key" off
		if [[ $which == dock ]]; then niri-dock stop 2>/dev/null
		else pkill -f "$TOP_PATTERN" 2>/dev/null; fi
	else
		niri-size kv set "$key" on
		if [[ $which == dock ]]; then niri-dock start 2>/dev/null; else start_top; fi
	fi
	return 0
}

toggle_all() {
	# waybar hides/shows itself on SIGUSR1; both instances listen
	pkill -USR1 -x waybar 2>/dev/null; pkill -USR1 -x .waybar-wrapped 2>/dev/null; true
}

bar_menu() {
	local choice
	choice=$(printf '%s\n' \
		"Settings"$'\t'preferences-system \
		"Show / hide the dock"$'\t'view-grid-symbolic \
		"Show / hide the top bar"$'\t'view-list-symbolic \
		"Restart bars"$'\t'view-refresh \
		"Theme picker"$'\t'preferences-desktop-theme \
		"Wallpaper picker"$'\t'preferences-desktop-wallpaper \
		| niri-menu -p Bars --lines 6) || return 0
	case $choice in
		"Settings") niri-settings ;;
		"Show / hide the dock") set_bar dock toggle ;;
		"Show / hide the top bar") set_bar top toggle ;;
		"Restart bars") restart_all; say "bars restarted" ;;
		"Theme picker") niri-theme pick ;;
		"Wallpaper picker") niri-wall pick ;;
		*) return 0 ;;
	esac
}

case "${1:-start}" in
	start) start_all ;;
	restart) restart_all ;;
	toggle) toggle_all ;;
	menu) bar_menu ;;
	size)   # niri-bars size [top|dock] [compact|small|normal|large]
		if [[ ${2:-} == top || ${2:-} == dock ]]; then
			if [[ -n ${3:-} ]]; then niri-size set "$2" "$3" || exit 1; restart_all; else niri-size get "$2"; fi
		elif [[ -n ${2:-} ]]; then
			niri-size set "$2" || exit 1
			restart_all
		else
			niri-size get
		fi
		;;
	dock) set_bar dock "${2:-toggle}" ;;
	top) set_bar top "${2:-toggle}" ;;
	style)
		if [[ -n ${2:-} ]]; then niri-size style "$2" || exit 1; restart_all; else niri-size style; fi
		;;
	*) warn "usage: niri-bars [start|restart|toggle|menu|size [top|dock] [size]|dock hide|show|toggle|top hide|show|toggle|style floating|docked]"; exit 1 ;;
esac
