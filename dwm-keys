#!/usr/bin/env bash
# dwm-keys - keybind cheat sheet shown in dmenu (Super+Shift+/)
# Pick nothing / press Escape to close. Colors follow the active theme.

BG="#2e3440" FG="#d8dee9" ACCENT="#88c0d0" ACCENT_FG="#2e3440"
# shellcheck source=/dev/null
[[ -r $HOME/.config/dwm-theme/current.sh ]] && . "$HOME/.config/dwm-theme/current.sh"

cat <<'EOF' | dmenu -l 45 -i -p "dwm keys" -fn "JetBrainsMono Nerd Font:size=11" \
	-nb "$BG" -nf "$FG" -sb "$ACCENT" -sf "$ACCENT_FG" >/dev/null
LAUNCH
  Super+Enter            terminal
  Super+P                app launcher (dmenu)
  Super+W                Firefox
  Super+E                Thunar file manager
  Super+Shift+/          this cheat sheet
LOOK
  Super+Shift+T          pick a theme (dwm, bars, Thunar, terminal)
  Super+Shift+W          pick a wallpaper (thumbnails: m to mark, q to apply)
  Super+Ctrl+W           random wallpaper
SCREENSHOTS
  Super+Shift+S          select region -> clipboard
  Print                  full screen -> ~/Pictures
WINDOWS
  Super+J / K            focus next / previous
  Super+Shift+Enter      swap with master
  Super+H / L            shrink / grow master area
  Super+I / D            more / fewer windows in master
  Super+Shift+C          close window
  Super+Shift+Space      toggle floating
  Super+B                hide / show bar
LAYOUTS
  Super+T                tiled
  Super+F                floating
  Super+M                monocle
  Super+Space            toggle last two layouts
TAGS
  Super+1-9              view tag
  Super+Shift+1-9        move window to tag
  Super+Ctrl+1-9         show multiple tags
  Super+0                view all tags
  Super+Tab              previous tag
MONITORS
  Super+, / .            focus prev / next monitor
  Super+Shift+, / .      send window to prev / next monitor
MOUSE
  Super+Left drag        move window
  Super+Right drag       resize window
  Super+Middle click     toggle floating
BOTTOM BAR
  click the brush        pick a theme
  click the picture      pick a wallpaper (right-click: random)
MEDIA KEYS
  Volume up/down/mute, brightness up/down
QUIT
  Super+Shift+Q          exit dwm (asks first)
EOF
