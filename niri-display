#!/usr/bin/env bash
# niri-display - display settings for niri: resolution and refresh rate, scale, rotation, on/off.
#
#   niri-display                         menu (choose a screen, then what to change)
#   niri-display list                    show screens, their modes and saved settings
#   niri-display mode <screen> <WxH@Hz>  e.g. niri-display mode eDP-1 1920x1080@60.000
#   niri-display scale <screen> <n>      e.g. 1.25
#   niri-display rotate <screen> <normal|90|180|270>
#   niri-display off|on <screen>
#   niri-display reset                   forget all saved display settings
#
# Changes apply immediately (niri msg output ...) and are saved to ~/.config/niri/display.conf; from that
# niri-display writes ~/.config/niri/display.kdl, which config.kdl includes, so they survive a restart.
# After a mode, scale or rotation change you get 12 seconds to confirm; otherwise the old setting returns.
set -u
export PATH="$HOME/.local/bin:$PATH"

CONF="${XDG_CONFIG_HOME:-$HOME/.config}/niri"
SAVED="$CONF/display.conf"      # lines: <screen> <key> <value>
KDL="$CONF/display.kdl"

say() { printf '%s\n' "$*"; }
msg() { echo "niri-display: $*" >&2; command -v notify-send >/dev/null 2>&1 && notify-send -a niri-display "$*" 2>/dev/null; return 0; }

outputs_json() { niri msg --json outputs 2>/dev/null; }

# ---- saved settings -> display.kdl

saved_get() {   # saved_get <screen> <key>
	[[ -r $SAVED ]] || return 0
	awk -v s="$1" -v k="$2" '$1==s && $2==k { v=$3 } END { if (v != "") print v }' "$SAVED"
}

saved_set() {   # saved_set <screen> <key> <value>  (empty value removes the key)
	mkdir -p "$CONF"
	touch "$SAVED"
	awk -v s="$1" -v k="$2" '!($1==s && $2==k)' "$SAVED" > "$SAVED.tmp"
	[[ -n ${3:-} ]] && printf '%s %s %s\n' "$1" "$2" "$3" >> "$SAVED.tmp"
	mv "$SAVED.tmp" "$SAVED"
	write_kdl
}

write_kdl() {
	python3 - "$SAVED" "$KDL" <<'PY'
import sys
saved, kdl = sys.argv[1], sys.argv[2]
screens = {}
try:
    for line in open(saved, encoding="utf-8"):
        parts = line.split()
        if len(parts) >= 3:
            screens.setdefault(parts[0], {})[parts[1]] = parts[2]
except OSError:
    pass
out = ["// generated by niri-display (niri-settings -> Display) - do not edit by hand"]
for name, kv in sorted(screens.items()):
    out.append('output "%s" {' % name)
    if kv.get("power") == "off":
        out.append("    off")
    else:
        if "mode" in kv:
            out.append('    mode "%s"' % kv["mode"])
        if "scale" in kv:
            out.append("    scale %s" % kv["scale"])
        if "transform" in kv:
            out.append('    transform "%s"' % kv["transform"])
    out.append("}")
open(kdl, "w", encoding="utf-8").write("\n".join(out) + "\n")
PY
}

# ---- screens

# print "<name>\t<make model>\t<current mode WxH@Hz>\t<scale>" for every screen
screens() {
	outputs_json | python3 -c '
import json, sys
try:
    data = json.load(sys.stdin)
except Exception:
    sys.exit(0)
for name, o in sorted(data.items()):
    cur = ""
    modes = o.get("modes") or []
    ci = o.get("current_mode")
    if isinstance(ci, int) and 0 <= ci < len(modes):
        m = modes[ci]
        cur = "%dx%d@%.3f" % (m["width"], m["height"], m["refresh_rate"] / 1000.0)
    logical = o.get("logical") or {}
    label = " ".join(x for x in (o.get("make"), o.get("model")) if x) or name
    print("%s\t%s\t%s\t%s" % (name, label, cur or "off", logical.get("scale", "")))
'
}

# print "<WxH@Hz>" for every mode of a screen, best first
modes_of() {
	outputs_json | python3 -c '
import json, sys
name = sys.argv[1]
try:
    o = json.load(sys.stdin)[name]
except Exception:
    sys.exit(0)
seen = set()
modes = sorted(o.get("modes") or [], key=lambda m: (-m["width"] * m["height"], -m["refresh_rate"]))
for m in modes:
    s = "%dx%d@%.3f" % (m["width"], m["height"], m["refresh_rate"] / 1000.0)
    if s not in seen:
        seen.add(s)
        print(s)
' "$1"
}

# ---- menus

menu() {   # menu <prompt>   (items on stdin: "label" or "label<TAB>icon") -> chosen label
	niri-menu -p "$1" --lines 8
}

# after a change: 12 seconds to keep it, otherwise run the undo command
confirm_or_revert() {   # confirm_or_revert <undo command...>
	local ans
	ans=$(printf '%s\n' "Keep these settings"$'\t'dialog-ok "Revert"$'\t'edit-undo | timeout 12 niri-menu -p "Keep display settings? (reverts in 12 s)" --lines 2 2>/dev/null || true)
	if [[ $ans != "Keep these settings" ]]; then
		"$@"
		msg "reverted"
		return 1
	fi
}

apply_mode() {   # apply_mode <screen> <mode>
	local s=$1 m=$2 prev
	prev=$(screens | awk -F'\t' -v s="$s" '$1==s{print $3}')
	niri msg output "$s" mode "$m" >/dev/null 2>&1 || { msg "niri did not accept mode $m for $s"; return 1; }
	if confirm_or_revert niri msg output "$s" mode "${prev:-auto}"; then saved_set "$s" mode "$m"; fi
}

apply_scale() {
	local s=$1 v=$2 prev
	prev=$(screens | awk -F'\t' -v s="$s" '$1==s{print $4}')
	niri msg output "$s" scale "$v" >/dev/null 2>&1 || { msg "niri did not accept scale $v for $s"; return 1; }
	if confirm_or_revert niri msg output "$s" scale "${prev:-1}"; then saved_set "$s" scale "$v"; fi
}

apply_rotate() {
	local s=$1 v=$2
	niri msg output "$s" transform "$v" >/dev/null 2>&1 || { msg "niri did not accept rotation $v for $s"; return 1; }
	local prev; prev=$(saved_get "$s" transform || true)
	if confirm_or_revert niri msg output "$s" transform "${prev:-normal}"; then saved_set "$s" transform "$v"; fi
}

apply_power() {   # apply_power <screen> on|off
	local s=$1 p=$2
	if [[ $p == off ]]; then
		local n; n=$(screens | wc -l)
		if (( n < 2 )); then msg "not turning off the only screen"; return 1; fi
	fi
	niri msg output "$s" "$p" >/dev/null 2>&1 || { msg "niri did not accept '$p' for $s"; return 1; }
	if [[ $p == off ]]; then saved_set "$s" power off; else saved_set "$s" power ""; fi
}

screen_menu() {   # screen_menu <screen>
	local s=$1 choice sel
	while :; do
		local cur scale
		cur=$(screens | awk -F'\t' -v s="$s" '$1==s{print $3}')
		scale=$(screens | awk -F'\t' -v s="$s" '$1==s{print $4}')
		choice=$(printf '%s\n' \
			"Resolution and refresh rate   ${cur:-?}"$'\t'video-display \
			"Scale                         ${scale:-?}"$'\t'zoom-in \
			"Rotation"$'\t'object-rotate-right \
			"Turn off this screen"$'\t'system-shutdown \
			"Turn on this screen"$'\t'video-display \
			"Back"$'\t'go-previous | menu "$s") || return 0
		case $choice in
			Resolution*)
				sel=$(modes_of "$s" | awk -v c="$cur" '{ print ($0==c ? "✓ " : "  ") $0 "\tvideo-display" }' | menu "Mode") || continue
				sel=${sel#✓ }; sel=${sel#  }
				[[ -n $sel ]] && apply_mode "$s" "$sel"
				;;
			Scale*)
				sel=$(printf '%s\tzoom-in\n' 1 1.25 1.5 1.75 2 2.5 3 | menu "Scale") || continue
				[[ -n $sel ]] && apply_scale "$s" "$sel"
				;;
			Rotation*)
				sel=$(printf '%s\tobject-rotate-right\n' normal 90 180 270 | menu "Rotation") || continue
				[[ -n $sel ]] && apply_rotate "$s" "$sel"
				;;
			"Turn off"*) apply_power "$s" off ;;
			"Turn on"*) apply_power "$s" on ;;
			*) return 0 ;;
		esac
	done
}

main_menu() {
	local list name sel count
	list=$(screens)
	[[ -n $list ]] || { msg "no screens found (is niri running?)"; return 1; }
	count=$(printf '%s\n' "$list" | wc -l)
	if (( count == 1 )); then
		screen_menu "$(printf '%s\n' "$list" | cut -f1)"
		return 0
	fi
	while :; do
		sel=$({ printf '%s\n' "$list" | awk -F'\t' '{ printf "%s   %s   %s   scale %s\tvideo-display\n", $1, $2, $3, $4 }'
			printf 'Forget saved display settings\tedit-clear\n'; } | menu "Screen") || return 0
		case $sel in
			Forget*) do_reset ;;
			"") return 0 ;;
			*) name=${sel%% *}; screen_menu "$name" ;;
		esac
		list=$(screens)
	done
}

do_reset() {
	rm -f "$SAVED" "$KDL"
	write_kdl
	msg "saved display settings removed (niri uses its defaults again after the next restart)"
}

list_all() {
	screens | while IFS=$'\t' read -r name label cur scale; do
		say "$name  ($label)  mode $cur  scale ${scale:-?}"
		modes_of "$name" | sed 's/^/    /'
	done
	[[ -s $SAVED ]] && { say; say "saved in $SAVED:"; sed 's/^/    /' "$SAVED"; }
	return 0
}

command -v niri >/dev/null 2>&1 || { echo "niri-display: niri is not installed" >&2; exit 1; }

case ${1:-menu} in
	menu) main_menu ;;
	list) list_all ;;
	mode)   [[ $# -ge 3 ]] || { echo "usage: niri-display mode <screen> <WxH@Hz>" >&2; exit 1; }; apply_mode "$2" "$3" ;;
	scale)  [[ $# -ge 3 ]] || { echo "usage: niri-display scale <screen> <n>" >&2; exit 1; }; apply_scale "$2" "$3" ;;
	rotate) [[ $# -ge 3 ]] || { echo "usage: niri-display rotate <screen> <normal|90|180|270>" >&2; exit 1; }; apply_rotate "$2" "$3" ;;
	off|on) [[ $# -ge 2 ]] || { echo "usage: niri-display $1 <screen>" >&2; exit 1; }; apply_power "$2" "$1" ;;
	reset) do_reset ;;
	*) sed -n '2,16p' "$0" | sed 's/^# \{0,1\}//'; exit 1 ;;
esac
